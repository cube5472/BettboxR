-    final effectiveStyle = span.style ?? parentStyle;
-
-    if (span.text != null && span.text!.isNotEmpty) {
-      segments.add((text: span.text!, style: effectiveStyle));
-    }
-
-    if (span.children != null) {
-      for (final child in span.children!) {
