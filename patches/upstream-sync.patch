diff --git a/test/clash/build_groups_test.dart b/test/clash/build_groups_test.dart
new file mode 100644
index 00000000..6d735801
--- /dev/null
+++ b/test/clash/build_groups_test.dart
@@ -0,0 +1,74 @@
+import 'dart:convert';
+
+import 'package:bett_box/clash/core.dart';
+import 'package:bett_box/enum/enum.dart';
+import 'package:bett_box/models/models.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  final proxies = json.encode({
+    'names': ['Main', 'Auto', 'A', 'B', 'DIRECT', 'Remote'],
+    'types': [
+      'Selector',
+      'URLTest',
+      'Shadowsocks',
+      'Trojan',
+      'Direct',
+      'Vless',
+    ],
+    'groups': [
+      {
+        'name': 'GLOBAL',
+        'type': 'Selector',
+        'now': 'Main',
+        'all': [0, 1, 2, 3],
+      },
+      {
+        'name': 'Main',
+        'type': 'Selector',
+        'now': 'Auto',
+        'all': [1, 2, 3, 4],
+      },
+      {
+        'name': 'Auto',
+        'type': 'URLTest',
+        'now': 'A',
+        'all': [2, 3, 5, 99],
+        'testUrl': 'https://example.com/204',
+        'hidden': true,
+        'icon': 'auto.png',
+      },
+      {
+        'name': 'Chain',
+        'type': 'Relay',
+        'all': [2],
+      },
+    ],
+  });
+
+  test('keeps the core order and shares proxy instances', () {
+    final groups = buildGroups(proxies);
+
+    expect(groups.map((group) => group.name), ['GLOBAL', 'Main', 'Auto']);
+    final main = groups[1];
+    expect(main.type, GroupType.Selector);
+    expect(main.now, 'Auto');
+    expect(main.all.map((proxy) => proxy.name), ['Auto', 'A', 'B', 'DIRECT']);
+    expect(
+      main.all.first,
+      const Proxy(name: 'Auto', type: 'URLTest', now: 'A'),
+    );
+    final auto = groups[2];
+    expect(auto.testUrl, 'https://example.com/204');
+    expect(auto.hidden, isTrue);
+    expect(auto.icon, 'auto.png');
+    expect(auto.all.map((proxy) => proxy.name), ['A', 'B', 'Remote']);
+    expect(auto.all.last, const Proxy(name: 'Remote', type: 'Vless'));
+    expect(identical(main.all[1], auto.all[0]), isTrue);
+  });
+
+  test('returns nothing for an empty payload', () {
+    expect(buildGroups('{}'), isEmpty);
+    expect(buildGroups('null'), isEmpty);
+  });
+}
diff --git a/test/clash/bundle_sync_test.dart b/test/clash/bundle_sync_test.dart
new file mode 100644
index 00000000..ee43957b
--- /dev/null
+++ b/test/clash/bundle_sync_test.dart
@@ -0,0 +1,80 @@
+import 'dart:io';
+
+import 'package:bett_box/clash/core.dart';
+import 'package:bett_box/common/common.dart';
+import 'package:bett_box/state.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  late Directory home;
+  late File bundle;
+  late File version;
+  late int bundledLength;
+
+  void setVersion(String version, String buildNumber) {
+    globalState.packageInfo = PackageInfo(
+      appName: 'Bettbox',
+      packageName: 'test',
+      version: version,
+      buildNumber: buildNumber,
+    );
+  }
+
+  setUp(() async {
+    home = await Directory.systemTemp.createTemp('bundle_sync');
+    bundle = File('${home.path}/$bundleMRSFileName');
+    version = File('${home.path}/$bundleMRSFileName.version');
+    bundledLength = (await rootBundle.load(
+      'assets/data/$bundleMRSFileName',
+    )).lengthInBytes;
+    setVersion('1.0.0', '1');
+  });
+
+  tearDown(() async {
+    await home.delete(recursive: true);
+  });
+
+  test('copies the packaged bundle when none exists', () async {
+    await ClashCore.syncBundleMRS(home.path);
+
+    expect(await bundle.length(), bundledLength);
+    expect(await version.readAsString(), '1.0.0+1');
+  });
+
+  test('keeps a bundle the user updated within the same version', () async {
+    await ClashCore.syncBundleMRS(home.path);
+    await bundle.writeAsString('downloaded');
+
+    await ClashCore.syncBundleMRS(home.path);
+
+    expect(await bundle.readAsString(), 'downloaded');
+  });
+
+  test('replaces the bundle after an app upgrade', () async {
+    await ClashCore.syncBundleMRS(home.path);
+    await bundle.writeAsString('downloaded');
+    setVersion('1.0.1', '2');
+
+    await ClashCore.syncBundleMRS(home.path);
+
+    expect(await bundle.length(), bundledLength);
+    expect(await version.readAsString(), '1.0.1+2');
+  });
+
+  test('replaces a bundle left by a version without a marker', () async {
+    await bundle.writeAsString('legacy');
+
+    await ClashCore.syncBundleMRS(home.path);
+
+    expect(await bundle.length(), bundledLength);
+    expect(await version.exists(), isTrue);
+    expect(
+      home.listSync().where((entity) => entity.path.endsWith('.tmp')),
+      isEmpty,
+    );
+  });
+}
diff --git a/test/clash/interface_test.dart b/test/clash/interface_test.dart
