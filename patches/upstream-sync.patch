+func parseAppleEndpoint(host string) (string, string) {
+	label, _, _ := strings.Cut(host, "-")
+	if len(label) < 5 {
+		return "", ""
+	}
+	for _, r := range label[:5] {
+		if r < 'a' || r > 'z' {
+			return "", ""
+		}
+	}
+	return strings.ToUpper(label[:2]), strings.ToUpper(label[2:5])
+}
