-            if (tok) {
-                if (js_define_var(s, var_name, tok))
-                    goto var_error;
-                scope = s->cur_func->scope_level;
-            }
-            if (s->token.val == '=') {  /* handle optional default value */
-                int label_hasval;
-                emit_op(s, OP_dup);
-                emit_op(s, OP_undefined);
