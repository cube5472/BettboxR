-                    if (has_ellipsis) {
-                        /* define the property in excludeList */
-                        emit_op(s, OP_perm3);
-                        emit_op(s, OP_null);
-                        emit_op(s, OP_define_array_el);
-                        emit_op(s, OP_perm3);
-                    }
-                    /* source prop -- source source prop */
-                    emit_op(s, OP_dup1);
-                } else {
-                    if (has_ellipsis) {
-                        /* define the property in excludeList */
-                        emit_op(s, OP_swap);
-                        emit_op(s, OP_null);
-                        emit_op(s, OP_define_field);
-                        emit_atom(s, prop_name);
-                        emit_op(s, OP_swap);
