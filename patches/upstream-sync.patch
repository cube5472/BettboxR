-static JSOSRWHandler *find_rh(JSThreadState *ts, int fd)
-{
-    JSOSRWHandler *rh;
-    struct list_head *el;
-
-    list_for_each(el, &ts->os_rw_handlers) {
-        rh = list_entry(el, JSOSRWHandler, link);
-        if (rh->fd == fd)
-            return rh;
-    }
-    return NULL;
