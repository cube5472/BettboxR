-    set_cycle_flag(ctx, proto);
-
-    JS_FreeValue(ctx, parent_proto);
-    JS_FreeValue(ctx, parent_class);
-
-    sp[-2] = ctor;
-    sp[-1] = proto;
-    return 0;
- fail:
-    JS_FreeValue(ctx, parent_class);
-    JS_FreeValue(ctx, parent_proto);
-    JS_FreeValue(ctx, bfunc);
-    JS_FreeValue(ctx, proto);
-    JS_FreeValue(ctx, ctor);
-    sp[-2] = JS_UNDEFINED;
-    sp[-1] = JS_UNDEFINED;
-    return -1;
-}
