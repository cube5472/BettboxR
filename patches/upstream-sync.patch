+          navigationStateProvider.overrideWith(
+            (ref) => NavigationState(
+              pageLabel: PageLabel.dashboard,
+              navigationItems: items,
+              viewMode: ViewMode.mobile,
+              locale: null,
+              currentIndex: 0,
+            ),
+          ),
+        ],
+        child: const MaterialApp(home: HomePage()),
+      ),
