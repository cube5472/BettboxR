+class _MediaBatchItem {
+  final String name;
+  final MediaPlatform platform;
+  final MediaUnlockResult? result;
+  final bool testing;
+
+  const _MediaBatchItem({
+    required this.name,
+    required this.platform,
+    this.result,
+    this.testing = false,
+  });
+
+  _MediaBatchItem reset() => _MediaBatchItem(name: name, platform: platform);
+}
