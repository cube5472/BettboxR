+class _SpeedTiles extends StatelessWidget {
+  final SpeedTestState? state;
+  final double scale;
+
+  const _SpeedTiles({required this.state, this.scale = 1.0});
+
+  @override
+  Widget build(BuildContext context) {
+    final state = this.state;
+    final phase = state?.phase;
