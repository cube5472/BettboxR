+++ b/core/provider_expand_test.go
@@ -0,0 +1,171 @@
+package main
+
+import (
+	"encoding/base64"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func expandProfile(t *testing.T, content string, options expandOptions) []string {
+	t.Helper()
+	rawCfg := parsePatchProfile(t, content)
+	if err := expandProxyProviders(rawCfg, options); err != nil {
+		t.Fatal(err)
+	}
+	if rawCfg.ProxyProvider != nil {
+		t.Fatal("proxy-providers should be removed")
+	}
+	var names []string
+	for _, proxy := range rawCfg.Proxy {
+		names = append(names, proxy["name"].(string))
+	}
+	return names
+}
+
+func TestExpandInlineProviderAppliesFilters(t *testing.T) {
+	names := expandProfile(t, `
+proxies:
+  - {name: HK 01, type: ss, server: a.com, port: 1, cipher: aes-128-gcm, password: p}
+proxy-providers:
+  inline:
+    type: inline
+    filter: HK|JP
+    exclude-filter: 过期
+    exclude-type: vmess
+    override:
+      additional-prefix: "[P] "
+      proxy-name:
+        - pattern: "HK"
+          target: "香港"
+    payload:
+      - {name: HK 01, type: ss, server: b.com, port: 2, cipher: aes-128-gcm, password: p}
+      - {name: JP 01, type: vmess, server: c.com, port: 3, uuid: 8e8a7c5f-3b6c-4c8f-9a51-8f0b5f4c2c11, cipher: auto}
+      - {name: JP 02, type: ss, server: d.com, port: 4, cipher: aes-128-gcm, password: p}
+      - {name: HK 过期, type: ss, server: e.com, port: 5, cipher: aes-128-gcm, password: p}
+`, expandOptions{})
+	want := []string{"HK 01", "[P] 香港 01", "[P] JP 02"}
+	if !reflect.DeepEqual(names, want) {
+		t.Fatalf("names = %v, want %v", names, want)
+	}
+}
+
+func TestExpandRenamesDuplicateNames(t *testing.T) {
+	names := expandProfile(t, `
+proxies:
+  - {name: HK, type: ss, server: a.com, port: 1, cipher: aes-128-gcm, password: p}
+proxy-groups:
+  - {name: JP, type: select, proxies: [HK]}
+proxy-providers:
+  one:
+    type: inline
+    payload:
+      - {name: HK, type: ss, server: b.com, port: 2, cipher: aes-128-gcm, password: p}
+      - {name: JP, type: ss, server: c.com, port: 3, cipher: aes-128-gcm, password: p}
+`, expandOptions{})
+	if want := []string{"HK", "HK 2", "JP 2"}; !reflect.DeepEqual(names, want) {
+		t.Fatalf("names = %v, want %v", names, want)
+	}
+}
+
+func TestExpandHttpProviderReadsCache(t *testing.T) {
+	dir := t.TempDir()
+	url := "http://127.0.0.1:1/sub"
+	cache := providerFilePath(dir, "proxies", url)
+	if err := os.MkdirAll(filepath.Dir(cache), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	links := "ss://" + base64.RawURLEncoding.EncodeToString([]byte("aes-128-gcm:pass")) + "@1.2.3.4:8388#Cached"
+	if err := os.WriteFile(cache, []byte(base64.StdEncoding.EncodeToString([]byte(links))), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	content := `
+proxy-providers:
+  sub:
+    type: http
+    url: ` + url + `
+    dialer-proxy: relay
+`
+	rawCfg := parsePatchProfile(t, content)
+	if err := expandProxyProviders(rawCfg, expandOptions{ProvidersPath: dir}); err != nil {
+		t.Fatal(err)
+	}
+	if len(rawCfg.Proxy) != 1 || rawCfg.Proxy[0]["name"] != "Cached" || rawCfg.Proxy[0]["dialer-proxy"] != "relay" {
+		t.Fatalf("proxies = %v", rawCfg.Proxy)
+	}
+	if err := expandProxyProviders(parsePatchProfile(t, content), expandOptions{ProvidersPath: dir, Refresh: true}); err != nil {
+		t.Fatalf("refresh should fall back to the cache: %v", err)
+	}
+}
+
+func TestExpandHttpProviderFallsBackToPayload(t *testing.T) {
+	names := expandProfile(t, `
+proxy-providers:
+  sub:
+    type: http
+    url: http://127.0.0.1:1/missing
+    payload:
+      - {name: Seed, type: ss, server: a.com, port: 1, cipher: aes-128-gcm, password: p}
+`, expandOptions{ProvidersPath: t.TempDir()})
+	if !reflect.DeepEqual(names, []string{"Seed"}) {
+		t.Fatalf("names = %v", names)
+	}
+}
+
+func TestExpandHttpProviderReportsMissingContent(t *testing.T) {
+	rawCfg := parsePatchProfile(t, `
+proxy-providers:
+  sub:
+    type: http
+    url: http://127.0.0.1:1/missing
+`)
+	if err := expandProxyProviders(rawCfg, expandOptions{ProvidersPath: t.TempDir()}); err == nil {
+		t.Fatal("expected an error")
+	}
+}
+
+func TestExpandHttpProviderHonorsInterval(t *testing.T) {
+	var hits atomic.Int32
+	links := "ss://" + base64.RawURLEncoding.EncodeToString([]byte("aes-128-gcm:pass")) + "@1.2.3.4:8388#Fresh"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		hits.Add(1)
+		_, _ = w.Write([]byte(links))
+	}))
+	defer server.Close()
+	dir := t.TempDir()
+	content := `
+proxy-providers:
+  sub:
+    type: http
+    url: ` + server.URL + `
+    interval: 3600
+`
+	expand := func() {
+		t.Helper()
+		if names := expandProfile(t, content, expandOptions{ProvidersPath: dir}); !reflect.DeepEqual(names, []string{"Fresh"}) {
+			t.Fatalf("names = %v", names)
+		}
+	}
+	expand()
+	cache := providerFilePath(dir, "proxies", server.URL)
+	if _, err := os.Stat(cache); err != nil {
+		t.Fatalf("download should be cached: %v", err)
+	}
+	expand()
+	if got := hits.Load(); got != 1 {
+		t.Fatalf("fresh cache should skip download, hits = %d", got)
+	}
+	stale := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(cache, stale, stale); err != nil {
+		t.Fatal(err)
+	}
+	expand()
+	if got := hits.Load(); got != 2 {
+		t.Fatalf("stale cache should download again, hits = %d", got)
+	}
+}
diff --git a/core/runtime_config.go b/core/runtime_config.go
new file mode 100644
index 00000000..6c9b2c16
--- /dev/null
+++ b/core/runtime_config.go
@@ -0,0 +1,224 @@
+package main
+
+import (
+	"encoding/json"
+
+	"github.com/metacubex/mihomo/config"
+	yamlv3 "go.yaml.in/yaml/v3"
+)
+
+func buildRuntimeConfigNode(
+	source []byte,
+	before *config.RawConfig,
+	after *config.RawConfig,
+	forced map[string]json.RawMessage,
+) (*yamlv3.Node, error) {
+	var document yamlv3.Node
+	if err := yamlv3.Unmarshal(source, &document); err != nil {
+		return nil, err
+	}
+	origin := &yamlv3.Node{Kind: yamlv3.MappingNode}
+	if document.Kind == yamlv3.DocumentNode && len(document.Content) > 0 &&
+		document.Content[0].Kind == yamlv3.MappingNode {
+		origin = expandYamlAliases(document.Content[0])
+	}
+	var beforeNode, afterNode yamlv3.Node
+	if err := beforeNode.Encode(before); err != nil {
+		return nil, err
+	}
+	if err := afterNode.Encode(after); err != nil {
+		return nil, err
+	}
+	root := mergeRuntimeMapping(origin, &beforeNode, &afterNode, forced)
+	normalizeYamlNode(root)
+	return root, nil
+}
+
+func mergeRuntimeNode(origin, before, after *yamlv3.Node) *yamlv3.Node {
+	if origin == nil {
+		return after
+	}
+	if before != nil && yamlNodeEqual(before, after) {
+		return origin
+	}
+	switch {
+	case origin.Kind == yamlv3.MappingNode && after.Kind == yamlv3.MappingNode:
+		return mergeRuntimeMapping(origin, before, after, nil)
+	case origin.Kind == yamlv3.SequenceNode && after.Kind == yamlv3.SequenceNode:
+		return mergeRuntimeSequence(origin, before, after)
+	}
+	return after
+}
+
+func mergeRuntimeMapping(
+	origin, before, after *yamlv3.Node,
+	forced map[string]json.RawMessage,
+) *yamlv3.Node {
+	result := &yamlv3.Node{Kind: yamlv3.MappingNode, Tag: after.Tag}
+	seen := map[string]bool{}
+	for i := 0; i+1 < len(origin.Content); i += 2 {
+		key, value := origin.Content[i], origin.Content[i+1]
+		seen[key.Value] = true
+		previous := yamlMappingValue(before, key.Value)
+		next := yamlMappingValue(after, key.Value)
+		if next == nil {
+			if previous == nil {
+				result.Content = append(result.Content, key, value)
+			}
+			continue
+		}
+		result.Content = append(
+			result.Content,
+			key,
+			mergeRuntimeNode(value, previous, next),
+		)
+	}
+	for i := 0; i+1 < len(after.Content); i += 2 {
+		key, value := after.Content[i], after.Content[i+1]
+		if seen[key.Value] {
+			continue
+		}
+		previous := yamlMappingValue(before, key.Value)
+		_, isForced := forced[key.Value]
+		if !isForced && previous != nil && yamlNodeEqual(previous, value) {
+			continue
+		}
+		result.Content = append(result.Content, key, value)
+	}
+	return result
+}
+
+func mergeRuntimeSequence(origin, before, after *yamlv3.Node) *yamlv3.Node {
+	result := &yamlv3.Node{Kind: yamlv3.SequenceNode, Tag: after.Tag}
+	aligned := before != nil &&
+		len(origin.Content) == len(after.Content) &&
+		len(before.Content) == len(after.Content)
+	for i, value := range after.Content {
+		var originItem, beforeItem *yamlv3.Node
+		if aligned {
+			originItem, beforeItem = origin.Content[i], before.Content[i]
+		} else if name := yamlMappingValue(value, "name"); name != nil &&
+			name.Kind == yamlv3.ScalarNode {
+			originItem = findYamlItemByName(origin, name.Value)
+			beforeItem = findYamlItemByName(before, name.Value)
+		}
+		result.Content = append(
+			result.Content,
+			mergeRuntimeNode(originItem, beforeItem, value),
+		)
+	}
+	return result
+}
+
+func findYamlItemByName(sequence *yamlv3.Node, name string) *yamlv3.Node {
+	if sequence == nil {
+		return nil
+	}
+	for _, item := range sequence.Content {
+		value := yamlMappingValue(item, "name")
+		if value != nil && value.Kind == yamlv3.ScalarNode && value.Value == name {
+			return item
+		}
+	}
+	return nil
+}
+
+func yamlMappingValue(node *yamlv3.Node, key string) *yamlv3.Node {
+	if node == nil || node.Kind != yamlv3.MappingNode {
+		return nil
+	}
+	for i := 0; i+1 < len(node.Content); i += 2 {
+		if node.Content[i].Value == key {
+			return node.Content[i+1]
+		}
+	}
+	return nil
+}
+
+func yamlNodeEqual(a, b *yamlv3.Node) bool {
+	if a.Kind != b.Kind || len(a.Content) != len(b.Content) {
+		return false
+	}
+	if a.Kind == yamlv3.ScalarNode && (a.Tag != b.Tag || a.Value != b.Value) {
+		return false
+	}
+	for i := range a.Content {
+		if !yamlNodeEqual(a.Content[i], b.Content[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func isYamlMergeKey(node *yamlv3.Node) bool {
+	return node.Kind == yamlv3.ScalarNode &&
+		(node.Tag == "!!merge" || (node.Tag == "" && node.Value == "<<"))
+}
+
+func expandYamlAliases(node *yamlv3.Node) *yamlv3.Node {
+	if node.Kind == yamlv3.AliasNode && node.Alias != nil {
+		return expandYamlAliases(node.Alias)
+	}
+	copied := *node
+	copied.Content = nil
+	if node.Kind != yamlv3.MappingNode {
+		for _, child := range node.Content {
+			copied.Content = append(copied.Content, expandYamlAliases(child))
+		}
+		return &copied
+	}
+	explicit := map[string]bool{}
+	for i := 0; i+1 < len(node.Content); i += 2 {
+		if !isYamlMergeKey(node.Content[i]) {
+			explicit[node.Content[i].Value] = true
+		}
+	}
+	added := map[string]bool{}
+	for i := 0; i+1 < len(node.Content); i += 2 {
+		key, value := node.Content[i], node.Content[i+1]
+		if !isYamlMergeKey(key) {
+			copied.Content = append(
+				copied.Content,
+				expandYamlAliases(key),
+				expandYamlAliases(value),
+			)
+			continue
+		}
+		sources := []*yamlv3.Node{expandYamlAliases(value)}
+		if sources[0].Kind == yamlv3.SequenceNode {
+			sources = sources[0].Content
+		}
+		for _, source := range sources {
+			if source.Kind != yamlv3.MappingNode {
+				continue
+			}
+			for j := 0; j+1 < len(source.Content); j += 2 {
+				name := source.Content[j].Value
+				if explicit[name] || added[name] {
+					continue
+				}
+				added[name] = true
+				copied.Content = append(
+					copied.Content,
+					source.Content[j],
+					source.Content[j+1],
+				)
+			}
+		}
+	}
+	return &copied
+}
+
+func normalizeYamlNode(node *yamlv3.Node) {
+	node.Anchor = ""
+	node.HeadComment = ""
+	node.LineComment = ""
+	node.FootComment = ""
+	switch node.Style {
+	case yamlv3.FlowStyle, yamlv3.DoubleQuotedStyle, yamlv3.SingleQuotedStyle:
+		node.Style = 0
+	}
+	for _, child := range node.Content {
+		normalizeYamlNode(child)
+	}
+}
