-    BOOL in_class;
-    StringBuffer b_s, *b = &b_s;
-    StringBuffer b2_s, *b2 = &b2_s;
-    uint32_t c;
-
-    p = s->buf_ptr;
-    p++;
-    in_class = FALSE;
-    if (string_buffer_init(s->ctx, b, 32))
-        return -1;
-    if (string_buffer_init(s->ctx, b2, 1))
-        goto fail;
