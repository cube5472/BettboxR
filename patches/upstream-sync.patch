-static no_inline int string_buffer_widen(StringBuffer *s, int size)
-{
-    JSString *str;
-    size_t slack;
-    int i;
-
-    if (s->error_status)
-        return -1;
-
-    str = js_realloc2(s->ctx, s->str, sizeof(JSString) + (size << 1), &slack);
-    if (!str)
-        return string_buffer_set_error(s);
-    size += slack >> 1;
-    for(i = s->len; i-- > 0;) {
-        str->u.str16[i] = str->u.str8[i];
-    }
-    s->is_wide_char = 1;
-    s->size = size;
-    s->str = str;
-    return 0;
-}
