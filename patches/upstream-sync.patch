-        }
-        val = JS_GetProperty(ctx, source, tab_atom[i].atom);
-        if (JS_IsException(val))
-            goto exception;
-        if (setprop)
-            ret = JS_SetProperty(ctx, target, tab_atom[i].atom, val);
-        else
-            ret = JS_DefinePropertyValue(ctx, target, tab_atom[i].atom, val,
-                                         JS_PROP_C_W_E);
-        if (ret < 0)
-            goto exception;
-    }
