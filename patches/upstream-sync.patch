-                JS_FreeValue(ctx, p->u.array.u.values[i]);
-            }
-            p->u.array.count = len;
-        }
-        p->prop[0].u.value = JS_NewUint32(ctx, len);
-    } else {
-        /* Note: length is always a uint32 because the object is an
-           array */
-        JS_ToUint32(ctx, &cur_len, p->prop[0].u.value);
-        if (len < cur_len) {
-            uint32_t d;
-            JSShape *sh;
-            JSShapeProperty *pr;
