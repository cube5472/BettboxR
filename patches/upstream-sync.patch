-static __exception int js_parse_expr_paren(JSParseState *s)
-{
-    if (js_parse_expect(s, '('))
-        return -1;
-    if (js_parse_expr(s))
-        return -1;
-    if (js_parse_expect(s, ')'))
-        return -1;
-    return 0;
-}
