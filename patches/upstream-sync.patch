+func groupShapeOf(outbound *adapter.Proxy) (groupShape, error) {
+	groupShapeLock.Lock()
+	defer groupShapeLock.Unlock()
+	if shape, exist := groupShapes[outbound]; exist {
+		return shape, nil
+	}
+	inner, err := outbound.ProxyAdapter.MarshalJSON()
+	if err != nil {
+		return groupShape{}, err
+	}
+	fields := struct {
