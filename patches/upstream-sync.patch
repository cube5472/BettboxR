-      final aLabel = a is LspCompletion ? a.label : a.toString();
-      final bLabel = b is LspCompletion ? b.label : b.toString();
-      final aScore = _scoreMatch(aLabel, prefix);
-      final bScore = _scoreMatch(bLabel, prefix);
