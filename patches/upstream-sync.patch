-static int find_closure_var(JSContext *ctx, JSFunctionDef *s,
-                            JSAtom var_name)
-{
-    int i;
-    for(i = 0; i < s->closure_var_count; i++) {
-        JSClosureVar *cv = &s->closure_var[i];
-        if (cv->var_name == var_name)
-            return i;
-    }
-    return -1;
-}
