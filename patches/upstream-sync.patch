+
+class _ReferenceChip extends StatelessWidget {
+  final String label;
+  final Widget? avatar;
+  final TextStyle? labelStyle;
+
+  const _ReferenceChip({required this.label, this.avatar, this.labelStyle});
+
+  @override
+  Widget build(BuildContext context) {
+    return ActionChip(
+      materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
+      avatar: avatar,
+      side: WidgetStateBorderSide.resolveWith((_) => null),
+      color: WidgetStateProperty.resolveWith((_) => null),
+      clipBehavior: Clip.antiAlias,
+      labelPadding: const EdgeInsets.symmetric(vertical: 0, horizontal: 4),
+      onPressed: () {},
+      labelStyle: labelStyle,
+      label: EmojiText(label),
+    );
+  }
+}
+
+typedef _ChipBuilder =
+    Widget Function(String label, {Widget? avatar, TextStyle? labelStyle});
+
+Widget _reference(String label, {Widget? avatar, TextStyle? labelStyle}) =>
+    _ReferenceChip(label: label, avatar: avatar, labelStyle: labelStyle);
+
+Widget _candidate(String label, {Widget? avatar, TextStyle? labelStyle}) =>
+    CommonChip(
+      label: label,
+      avatar: avatar,
+      labelStyle: labelStyle,
+      onPressed: () {},
+    );
+
+Widget _gallery(BuildContext context, _ChipBuilder chip) {
+  final small = Theme.of(context).textTheme.bodySmall?.copyWith(
+    color: Theme.of(context).colorScheme.onSurfaceVariant,
+  );
+  return Column(
+    crossAxisAlignment: CrossAxisAlignment.start,
+    spacing: 7,
+    children: [
+      chip('DIRECT'),
+      chip('Proxy', labelStyle: small),
+      chip('sync', avatar: const Icon(Icons.sync)),
+      SizedBox(
+        width: 90,
+        child: Wrap(children: [chip('a very long chip label that overflows')]),
+      ),
+      SizedBox(
+        width: 110,
+        child: Wrap(
+          children: [
+            chip(
+              'a very long chip label that overflows',
+              avatar: const Icon(Icons.upload),
+            ),
+          ],
+        ),
+      ),
+      SizedBox(
+        height: 36,
+        child: SingleChildScrollView(
+          scrollDirection: Axis.horizontal,
+          child: Row(
+            spacing: 6,
+            children: [
+              chip('one', labelStyle: small),
+              chip('two', labelStyle: small),
+            ],
+          ),
+        ),
+      ),
+    ],
+  );
+}
+
+Future<(ui.Image, ByteData)> _capture(WidgetTester tester, Key key) async {
+  final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(key));
+  final image = await boundary.toImage();
+  final data = await image.toByteData();
+  return (image, data!);
+}
+
+void main() {
+  for (final brightness in Brightness.values) {
+    for (final density in [VisualDensity.standard, VisualDensity.compact]) {
+      for (final scale in [1.0, 1.3]) {
+        testWidgets(
+          '轻量 action chip 与 ActionChip 外观一致 $brightness $density x$scale',
+          (tester) async {
+            const referenceKey = ValueKey('reference');
+            const candidateKey = ValueKey('candidate');
+            final colorScheme = ColorScheme.fromSeed(
+              seedColor: Colors.indigo,
+              brightness: brightness,
+            );
+            await tester.pumpWidget(
+              MaterialApp(
+                theme: ThemeData(
+                  colorScheme: colorScheme,
+                  visualDensity: density,
+                  chipTheme: ChipThemeData(
+                    shape: const RoundedRectangleBorder(
+                      borderRadius: BorderRadius.all(Radius.circular(16)),
+                    ),
+                    side: BorderSide(
+                      color: colorScheme.outlineVariant.withValues(alpha: 0.6),
+                    ),
+                  ),
+                ),
+                builder: (context, child) => MediaQuery(
+                  data: MediaQuery.of(
+                    context,
+                  ).copyWith(textScaler: TextScaler.linear(scale)),
+                  child: child!,
+                ),
+                home: Scaffold(
+                  body: Builder(
+                    builder: (context) => Row(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      children: [
+                        RepaintBoundary(
+                          key: referenceKey,
+                          child: SizedBox(
+                            width: 300,
+                            height: 400,
+                            child: _gallery(context, _reference),
+                          ),
+                        ),
+                        RepaintBoundary(
+                          key: candidateKey,
+                          child: SizedBox(
+                            width: 300,
+                            height: 400,
+                            child: _gallery(context, _candidate),
+                          ),
+                        ),
+                      ],
+                    ),
+                  ),
+                ),
+              ),
+            );
+            await tester.pumpAndSettle();
+
+            final referenceSizes = [
+              for (final element in find.byType(ActionChip).evaluate())
+                element.size,
+            ];
+            final candidateSizes = [
+              for (final element in find.byType(CommonChip).evaluate())
+                element.size,
+            ];
+            expect(candidateSizes, referenceSizes);
+
+            await tester.runAsync(() async {
+              final (referenceImage, reference) = await _capture(
+                tester,
+                referenceKey,
+              );
+              final (candidateImage, candidate) = await _capture(
+                tester,
+                candidateKey,
+              );
+              expect(candidateImage.width, referenceImage.width);
+              expect(candidateImage.height, referenceImage.height);
+              var different = 0;
+              var maxDelta = 0;
+              for (var i = 0; i < reference.lengthInBytes; i++) {
+                final delta = (reference.getUint8(i) - candidate.getUint8(i))
+                    .abs();
+                if (delta > 0) different++;
+                if (delta > maxDelta) maxDelta = delta;
+              }
+              expect(maxDelta, lessThanOrEqualTo(10));
+              expect(different, lessThan(2000));
+            });
+          },
+        );
+      }
+    }
+  }
+
+  testWidgets('点击、聚焦与按键触发', (tester) async {
+    var taps = 0;
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
+          body: CommonChip(label: 'chip', onPressed: () => taps++),
+        ),
+      ),
+    );
+    await tester.tap(find.byType(CommonChip));
+    await tester.pump();
+    expect(taps, 1);
+
+    final size = tester.getSize(find.byType(CommonChip));
+    Focus.of(tester.element(find.byType(EmojiText))).requestFocus();
+    await tester.pump();
+    await tester.pump();
+    expect(tester.getSize(find.byType(CommonChip)), size + const Offset(2, 2));
+
+    await tester.sendKeyEvent(LogicalKeyboardKey.enter);
+    expect(taps, 2);
+    await tester.sendKeyEvent(LogicalKeyboardKey.select);
+    expect(taps, 3);
+    await tester.sendKeyEvent(LogicalKeyboardKey.arrowDown);
+    expect(taps, 3);
+  });
+}
diff --git a/test/widgets/common_target_icon_test.dart b/test/widgets/common_target_icon_test.dart
new file mode 100644
index 00000000..861f5b05
--- /dev/null
+++ b/test/widgets/common_target_icon_test.dart
@@ -0,0 +1,122 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:bett_box/widgets/widgets.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+
+const _pngs = {
+  'red':
+      'iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAYAAADED76LAAAAEklEQVR4nGP4z8DwHx9mGBkKAMLXf4EvceABAAAAAElFTkSuQmCC',
+  'blue':
+      'iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAYAAADED76LAAAAEUlEQVR4nGNgYPj/Hz8eEQoAQ1d/gZtbdTsAAAAASUVORK5CYII=',
+};
+
+const _rgb = {'red': (255, 0, 0), 'blue': (0, 0, 255)};
+
+void main() {
+  late String tmp;
+  late HttpServer server;
+  var color = 'red';
+
+  setUpAll(() async {
+    HttpOverrides.global = null;
+    tmp = Directory.systemTemp.createTempSync('target_icon').path;
+    TestWidgetsFlutterBinding.ensureInitialized();
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(
+          const MethodChannel('plugins.flutter.io/path_provider'),
+          (_) async => tmp,
+        );
+    server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen((request) {
+      final response = request.response;
+      if (request.uri.path.startsWith('/png')) {
+        response
+          ..headers.contentType = ContentType('image', 'png')
+          ..add(base64.decode(_pngs[color]!));
+      } else {
+        final fill = _rgb[color]!;
+        response
+          ..headers.contentType = ContentType('image', 'svg+xml')
+          ..write(
+            '<?xml version="1.0"?>\n'
+            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10">'
+            '<rect width="10" height="10" '
+            'fill="rgb(${fill.$1},${fill.$2},${fill.$3})"/></svg>',
+          );
+      }
+      response.close();
+    });
+  });
+
+  tearDownAll(() => server.close(force: true));
+
+  Future<void> settle(WidgetTester tester) async {
+    for (var i = 0; i < 40; i++) {
+      await tester.runAsync(
+        () => Future.delayed(const Duration(milliseconds: 30)),
+      );
+      await tester.pump(const Duration(milliseconds: 50));
+    }
+  }
+
+  Future<String?> centerColor(WidgetTester tester, GlobalKey key) async {
+    return tester.runAsync(() async {
+      final boundary =
+          key.currentContext!.findRenderObject()! as RenderRepaintBoundary;
+      final image = await boundary.toImage();
+      final data = await image.toByteData(
+        format: ui.ImageByteFormat.rawStraightRgba,
+      );
+      final offset = ((image.height ~/ 2) * image.width + image.width ~/ 2) * 4;
+      final pixel = (
+        data!.getUint8(offset),
+        data.getUint8(offset + 1),
+        data.getUint8(offset + 2),
+      );
+      image.dispose();
+      if (pixel.$1 > 200 && pixel.$2 < 60 && pixel.$3 < 60) return 'red';
+      if (pixel.$3 > 200 && pixel.$1 < 60 && pixel.$2 < 60) return 'blue';
+      return '$pixel';
+    });
+  }
+
+  for (final path in [
+    '/a.svg',
+    '/b.svg?v=2',
+    '/icon',
+    '/png/a.png',
+    '/png/b.png?v=2',
+    '/png/icon',
+  ]) {
+    testWidgets('$path renders and refreshes after reset', (tester) async {
+      color = 'red';
+      await tester.runAsync(CommonTargetIcon.clearCache);
+      final key = GlobalKey();
+      final url = 'http://127.0.0.1:${server.port}$path';
+      await tester.pumpWidget(
+        MaterialApp(
+          home: Center(
+            child: RepaintBoundary(
+              key: key,
+              child: ColoredBox(
+                color: Colors.white,
+                child: CommonTargetIcon(src: url, size: 40),
+              ),
+            ),
+          ),
+        ),
+      );
+      await settle(tester);
+      expect(await centerColor(tester, key), 'red');
+      color = 'blue';
+      await tester.runAsync(CommonTargetIcon.clearCache);
+      await settle(tester);
+      expect(await centerColor(tester, key), 'blue');
+    });
+  }
+}
diff --git a/test/widgets/continuous_list_item_test.dart b/test/widgets/continuous_list_item_test.dart
new file mode 100644
index 00000000..291f0448
--- /dev/null
+++ b/test/widgets/continuous_list_item_test.dart
@@ -0,0 +1,202 @@
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:bett_box/widgets/list.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class _ReferenceItem extends StatelessWidget {
+  final Widget child;
+  final int index;
+  final int count;
+
+  const _ReferenceItem({
+    required this.child,
+    required this.index,
+    required this.count,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final colorScheme = Theme.of(context).colorScheme;
+    final isFirst = index == 0;
+    final isLast = index == count - 1;
+    final isLight = colorScheme.brightness == Brightness.light;
+    final dividerColor = colorScheme.outlineVariant.withValues(
+      alpha: isLight ? 0.45 : 0.25,
+    );
+    return Container(
+      margin: const EdgeInsets.symmetric(horizontal: 16),
+      decoration: BoxDecoration(
+        color: isLight
+            ? Color.lerp(
+                colorScheme.surface,
+                colorScheme.surfaceContainerLowest,
+                0.5,
+              )
+            : colorScheme.surfaceContainerHigh,
+        borderRadius: BorderRadius.vertical(
+          top: isFirst ? const Radius.circular(20) : Radius.zero,
+          bottom: isLast ? const Radius.circular(20) : Radius.zero,
+        ),
+      ),
+      clipBehavior: Clip.antiAlias,
+      child: Material(
+        type: MaterialType.transparency,
+        child: LayoutBuilder(
+          builder: (context, constraints) {
+            return Column(
+              mainAxisSize: MainAxisSize.min,
+              children: [
+                if (constraints.hasTightHeight)
+                  Expanded(
+                    child: Align(alignment: Alignment.center, child: child),
+                  )
+                else
+                  child,
+                Container(
+                  height: 1,
+                  margin: const EdgeInsets.symmetric(horizontal: 16),
+                  color: isLast ? Colors.transparent : dividerColor,
+                ),
+              ],
+            );
+          },
+        ),
+      ),
+    );
+  }
+}
+
+typedef _ItemBuilder = Widget Function(int index, int count, Widget child);
+
+Widget _gallery(_ItemBuilder item) {
+  Widget content(int index, {double? width}) => Container(
+    width: width,
+    height: 30.0 + index * 7,
+    color: Colors.teal.withValues(alpha: 0.4),
+    alignment: Alignment.centerLeft,
+    child: Text('row $index'),
+  );
+  return Column(
+    children: [
+      for (var i = 0; i < 3; i++)
+        SizedBox(height: 60, child: item(i, 3, content(i))),
+      const SizedBox(height: 9),
+      for (var i = 0; i < 3; i++) item(i, 3, content(i)),
+      const SizedBox(height: 9),
+      SizedBox(height: 70, child: item(0, 1, content(0, width: 120))),
+      const SizedBox(height: 9),
+      item(0, 1, content(1, width: 120)),
+    ],
+  );
+}
+
+Future<(ui.Image, ByteData)> _capture(WidgetTester tester, Key key) async {
+  final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(key));
+  final image = await boundary.toImage();
+  final data = await image.toByteData();
+  return (image, data!);
+}
+
+void main() {
+  for (final brightness in Brightness.values) {
+    testWidgets('ContinuousListItem 布局与绘制保持一致 $brightness', (tester) async {
+      const referenceKey = ValueKey('reference');
+      const candidateKey = ValueKey('candidate');
+      await tester.pumpWidget(
+        MaterialApp(
+          theme: ThemeData(
+            colorScheme: ColorScheme.fromSeed(
+              seedColor: Colors.indigo,
+              brightness: brightness,
+            ),
+          ),
+          home: Scaffold(
+            body: Row(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                RepaintBoundary(
+                  key: referenceKey,
+                  child: SizedBox(
+                    width: 320,
+                    height: 560,
+                    child: _gallery(
+                      (index, count, child) => _ReferenceItem(
+                        index: index,
+                        count: count,
+                        child: child,
+                      ),
+                    ),
+                  ),
+                ),
+                RepaintBoundary(
+                  key: candidateKey,
+                  child: SizedBox(
+                    width: 320,
+                    height: 560,
+                    child: _gallery(
+                      (index, count, child) => ContinuousListItem(
+                        index: index,
+                        count: count,
+                        child: child,
+                      ),
+                    ),
+                  ),
+                ),
+              ],
+            ),
+          ),
+        ),
+      );
+
+      List<Rect> rects(Finder finder, Key scope) {
+        final origin = tester.getTopLeft(find.byKey(scope));
+        return [
+          for (final element in finder.evaluate())
+            tester
+                .getRect(find.byElementPredicate((e) => e == element))
+                .shift(-origin),
+        ];
+      }
+
+      Finder within(Key scope, Finder matching) =>
+          find.descendant(of: find.byKey(scope), matching: matching);
+
+      expect(
+        rects(within(candidateKey, find.byType(Text)), candidateKey),
+        rects(within(referenceKey, find.byType(Text)), referenceKey),
+      );
+      expect(
+        rects(
+          within(candidateKey, find.byType(ContinuousListItem)),
+          candidateKey,
+        ),
+        rects(within(referenceKey, find.byType(_ReferenceItem)), referenceKey),
+      );
+
+      await tester.runAsync(() async {
+        final (referenceImage, reference) = await _capture(
+          tester,
+          referenceKey,
+        );
+        final (candidateImage, candidate) = await _capture(
+          tester,
+          candidateKey,
+        );
+        expect(candidateImage.width, referenceImage.width);
+        expect(candidateImage.height, referenceImage.height);
+        var different = 0;
+        var maxDelta = 0;
+        for (var i = 0; i < reference.lengthInBytes; i++) {
+          final delta = (reference.getUint8(i) - candidate.getUint8(i)).abs();
+          if (delta > 0) different++;
+          if (delta > maxDelta) maxDelta = delta;
+        }
+        expect(different, 0);
+        expect(maxDelta, 0);
+      });
+    });
+  }
+}
diff --git a/test/widgets/editable_grid_test.dart b/test/widgets/editable_grid_test.dart
