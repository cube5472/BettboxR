-        arg_buf = alloca(sizeof(arg_buf[0]) * arg_count);
-        for(i = 0; i < argc; i++)
-            arg_buf[i] = argv[i];
-        for(i = argc; i < arg_count; i++)
-            arg_buf[i] = JS_UNDEFINED;
-        sf->arg_count = arg_count;
-    }
-    sf->arg_buf = (JSValue*)arg_buf;
