-static void free_rw_handler(JSRuntime *rt, JSOSRWHandler *rh)
-{
-    int i;
-    list_del(&rh->link);
-    for(i = 0; i < 2; i++) {
-        JS_FreeValueRT(rt, rh->rw_func[i]);
-    }
-    js_free_rt(rt, rh);
