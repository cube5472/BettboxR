+  void _toggleRisk() {
+    final detail = _riskIp == null;
+    if (widget.persistRisk) {
+      ref
+          .read(appSettingProvider.notifier)
+          .updateState((state) => state.copyWith(ipRiskDetail: detail));
+    }
+    if (detail) {
+      _loadRisk(widget.ip);
+      return;
+    }
+    setState(() {
+      _riskSerial++;
+      _riskIp = null;
+      _risk = null;
+      _riskFailed = false;
+      _editing = false;
+    });
+  }
+
+  Widget _buildRiskButton() {
+    return _buildIconButton(
