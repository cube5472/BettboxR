+// Ten lines, so inserting two keeps two-digit line numbers: a wider gutter
+// would narrow the wrap width and change every row count.
+final _lines = [
+  'root:',
+  '  a: ${'x' * 120}',
+  '  b: {',
+  '    c: 1',
+  '    d: 2',
+  '  }',
+  '  e: ${'y' * 60}',
+  'f: 1',
+  'g: 2',
+  'end: true',
+];
