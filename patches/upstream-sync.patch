-/* return the label ID offset */
-static int emit_label(JSParseState *s, int label)
-{
-    if (label >= 0) {
-        emit_op(s, OP_label);
-        emit_u32(s, label);
-        s->cur_func->label_slots[label].pos = s->cur_func->byte_code.size;
-        return s->cur_func->byte_code.size - 4;
-    } else {
-        return -1;
-    }
