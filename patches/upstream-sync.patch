+    _lastPort = port;
+    _lastNetwork = _network;
+    _portController.text = '$port';
+    FocusScope.of(context).unfocus();
+    setState(() => _tracing = true);
+    final result = await clashCore.routeTrace(
+      target: target,
+      network: _network,
+      port: port,
