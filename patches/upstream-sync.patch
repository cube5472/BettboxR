-#define POP_STACK_LEN_MAX 4
-
-static int unicode_prop_ops(CharRange *cr, ...)
-{
-    va_list ap;
-    CharRange stack[POP_STACK_LEN_MAX];
-    int stack_len, op, ret, i;
-    uint32_t a;
-    
-    va_start(ap, cr);
-    stack_len = 0;
-    for(;;) {
-        op = va_arg(ap, int);
