-                        update_label(s, cc.label, +1);
-                        dbuf_putc(&bc_out, op1);
-                        dbuf_put_u32(&bc_out, cc.label);
-                        pos_next = pos1;
-                        if (line1 != -1 && line1 != line_num) {
-                            line_num = line1;
-                            s->line_number_size++;
-                            dbuf_putc(&bc_out, OP_line_num);
-                            dbuf_put_u32(&bc_out, line_num);
-                        }
