-void compute_internal_props(void)
-{
-    int i;
-    BOOL has_ul;
-
-    for(i = 0; i <= CHARCODE_MAX; i++) {
-        CCInfo *ci = &unicode_db[i];
-        has_ul = (ci->u_len != 0 || ci->l_len != 0 || ci->f_code != 0);
-        if (has_ul) {
-            assert(get_prop(i, PROP_Cased));
-        } else {
-            set_prop(i, PROP_Cased1, get_prop(i, PROP_Cased));
