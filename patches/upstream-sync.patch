-static __exception int js_parse_block(JSParseState *s)
-{
-    if (js_parse_expect(s, '{'))
-        return -1;
-    if (s->token.val != '}') {
-        push_scope(s);
-        for(;;) {
-            if (js_parse_statement_or_decl(s, DECL_MASK_ALL))
-                return -1;
-            if (s->token.val == '}')
-                break;
-        }
-        pop_scope(s);
-    }
-    if (next_token(s))
-        return -1;
-    return 0;
