+func patchParams(t *testing.T, content string) *PatchParams {
+	t.Helper()
+	params := &PatchParams{HealthCheckTimeout: defaultHealthCheckTimeout}
+	if err := UnmarshalJson([]byte(content), params); err != nil {
+		t.Fatal(err)
+	}
+	return params
+}
