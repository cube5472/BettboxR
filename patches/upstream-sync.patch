-/* 0 <= c <= 0xff */
-static int string_buffer_putc8(StringBuffer *s, uint32_t c)
-{
-    if (unlikely(s->len >= s->size)) {
-        if (string_buffer_realloc(s, s->len + 1, c))
-            return -1;
