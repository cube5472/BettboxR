-    int i, n;
-    double a, val;
-
-    if (JS_IsUndefined(new_target)) {
-        /* invoked as function */
-        argc = 0;
-    }
-    n = argc;
-    if (n == 0) {
-        val = date_now();
-    } else if (n == 1) {
-        JSValue v, dv;
-        if (JS_VALUE_GET_TAG(argv[0]) == JS_TAG_OBJECT) {
-            JSObject *p = JS_VALUE_GET_OBJ(argv[0]);
-            if (p->class_id == JS_CLASS_DATE && JS_IsNumber(p->u.object_data)) {
-                if (JS_ToFloat64(ctx, &val, p->u.object_data))
-                    return JS_EXCEPTION;
-                val = time_clip(val);
-                goto has_val;
