-    if (!ps)
-        return;
-    
-    ref_count = atomic_add_int(&ps->ref_count, -1);
-    assert(ref_count >= 0);
-    if (ref_count == 0) {
-        list_for_each_safe(el, el1, &ps->msg_queue) {
-            msg = list_entry(el, JSWorkerMessage, link);
-            js_free_message(msg);
