+          start: match.start,
+          end: match.end,
+          isCurrentMatch: index == _currentMatchIndex,
+        ),
+    ];
+    notifyListeners();
+  }
+}
+
+class SearchHighlight {
+  final int start;
+  final int end;
+  final bool isCurrentMatch;
+
+  const SearchHighlight({
+    required this.start,
+    required this.end,
+    this.isCurrentMatch = false,
+  });
+}
