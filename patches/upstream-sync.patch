-void dump_byte_table(FILE *f, const char *cname, const uint8_t *tab, int len)
-{
-    int i;
-    fprintf(f, "static const uint8_t %s[%d] = {", cname, len);
-    for(i = 0; i < len; i++) {
-        if (i % 8 == 0)
-            fprintf(f, "\n   ");
-        fprintf(f, " 0x%02x,", tab[i]);
-    }
-    fprintf(f, "\n};\n\n");
-}
