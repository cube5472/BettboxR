-    p = s->last_ptr = s->buf_ptr;
-    s->got_lf = FALSE;
-    s->last_line_num = s->token.line_num;
- redo:
-    s->token.line_num = s->line_num;
-    s->token.ptr = p;
-    c = *p;
-    switch(c) {
-    case 0:
-        if (p >= s->buf_end) {
-            s->token.val = TOK_EOF;
-        } else {
-            goto def_token;
-        }
