-static int update_label(JSFunctionDef *s, int label, int delta)
-{
-    LabelSlot *ls;
-
-    assert(label >= 0 && label < s->label_count);
-    ls = &s->label_slots[label];
-    ls->ref_count += delta;
-    assert(ls->ref_count >= 0);
-    return ls->ref_count;
-}
