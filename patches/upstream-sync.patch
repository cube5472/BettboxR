+          _ServicePill(
+            key: ValueKey(route.id),
+            icon: widget.catalog.iconUrlOf(route),
+            label: route.name,
+            present: true,
+            removing: _removed.contains(route.id),
+            onTap: () => _toggleRemoved(route),
+          ),
+    ];
+  }
