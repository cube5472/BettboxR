-
-    for (int i = 0; i < lineText.length; i++) {
-      final ch = lineText[i];
-      if (ch == ' ') {
-        columns += 1;
-      } else if (ch == '\t') {
-        final nextStop = tabSize <= 0
-            ? columns + 1
-            : columns + (tabSize - (columns % tabSize));
