-    fprintf(fp, "%-20s %8s %8s\n", "NAME", "COUNT", "SIZE");
-
-    if (s->malloc_count) {
-        fprintf(fp, "%-20s %8"PRId64" %8"PRId64"  (%0.1f per block)\n",
-                "memory allocated", s->malloc_count, s->malloc_size,
