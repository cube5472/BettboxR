+            "icons": { "AI": "ai.png", "Streaming": "tv.png" },
+            "policyGroupOptions": ["AI", "Streaming"],
+        })
+    );
+}
+
+#[test]
+fn extracts_empty_options_from_a_plain_script() {
+    let options: Json =
