-    s->token.val = TOK_REGEXP;
-    s->token.u.regexp.body = string_buffer_end(b);
-    s->token.u.regexp.flags = string_buffer_end(b2);
-    s->buf_ptr = p;
-    return 0;
- fail:
-    string_buffer_free(b);
-    string_buffer_free(b2);
-    return -1;
-}
