-    if (async_func_init(ctx, &s->func_state, func_obj, this_obj, argc, argv)) {
-    fail:
-        JS_FreeValue(ctx, promise);
-        js_async_function_free(ctx->rt, s);
-        return JS_EXCEPTION;
-    }
-    s->is_active = TRUE;
-
-    js_async_function_resume(ctx, s);
-
-    js_async_function_free(ctx->rt, s);
