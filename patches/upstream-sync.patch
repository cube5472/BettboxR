+  final bool failed;
+
+  const _IpEntry({
+    required this.label,
+    this.ip = '',
+    this.info,
+    this.loading = false,
+    this.failed = false,
+  });
+
+  _IpEntry copyWith({String? ip, IpInfo? info, bool? loading, bool? failed}) =>
+      _IpEntry(
+        label: label,
+        ip: ip ?? this.ip,
+        info: info ?? this.info,
