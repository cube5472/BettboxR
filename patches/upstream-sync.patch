+class DashboardDecor extends ConsumerWidget {
+  final Widget mark;
+  final bool bottom;
+  final double angle;
+  final double size;
+  final Widget child;
+
+  const DashboardDecor({
+    super.key,
+    required this.mark,
+    required this.child,
+    this.bottom = false,
+    this.angle = 0,
+    this.size = 80,
+  });
+
+  static Widget icon(BuildContext context, IconData icon, double size) => Icon(
+    icon,
+    size: size,
+    color: context.colorScheme.onSurface.withValues(alpha: 0.06),
+  );
+
+  static Widget flag(String countryCode, double size) => Opacity(
+    opacity: 0.14,
+    child: ColorFiltered(
+      colorFilter: const ColorFilter.matrix([
+        0.33,
+        0.33,
+        0.33,
+        0,
+        0,
+        0.33,
+        0.33,
+        0.33,
+        0,
+        0,
+        0.33,
+        0.33,
+        0.33,
+        0,
+        0,
+        0,
+        0,
+        0,
+        1,
+        0,
+      ]),
+      child: Text(
+        utils.countryCodeToEmoji(countryCode),
+        style: TextStyle(
+          fontFamily: FontFamily.twEmoji.value,
+          fontFamilyFallback: [FontFamily.twEmoji.value],
+          fontSize: size * 0.86,
+          height: 1,
+        ),
+      ),
+    ),
+  );
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final visible = ref.watch(
+      appSettingProvider.select((state) => state.dashboardWatermark),
+    );
+    if (!visible) return child;
+    final offset = -size * 0.17;
+    return Stack(
+      children: [
+        PositionedDirectional(
+          end: offset,
+          top: bottom ? null : offset,
+          bottom: bottom ? offset : null,
+          child: IgnorePointer(
+            child: Transform.rotate(angle: angle, child: mark),
+          ),
+        ),
+        Positioned.fill(child: child),
+      ],
+    );
+  }
+}
