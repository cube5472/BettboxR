+List<Proxy> sortProxies(
+  List<Proxy> proxies,
+  ProxiesSortType sortType, {
+  int? Function(String proxyName)? delayOf,
+}) {
+  final order = switch (sortType) {
+    ProxiesSortType.none => null,
+    // Ручной порядок применяется поверх исходного (sortProxiesByOrder
+    // вызывается в getSortProxies/SortedGroupProxies отдельно).
+    ProxiesSortType.custom => null,
+    ProxiesSortType.name => sortOrderByName(_nameSortKeys(proxies)),
+    ProxiesSortType.delay => sortOrderByDelay(
+      _delaySortValues(proxies, delayOf),
+    ),
+  };
+  if (order == null) return proxies;
+  return [for (final index in order) proxies[index]];
+}
+
+/// Ручной порядок: ноды из сохранённого списка идут в заданном порядке,
+/// остальные (новые/переименованные) добавляются в конец в исходном порядке.
+List<Proxy> sortProxiesByOrder(List<Proxy> proxies, List<String> order) {
+  if (order.isEmpty) return proxies;
+  final orderIndex = <String, int>{
+    for (var i = 0; i < order.length; i++) order[i]: i,
+  };
+  final sorted = <Proxy>[];
+  final unsorted = <Proxy>[];
+  for (final proxy in proxies) {
+    if (orderIndex.containsKey(proxy.name)) {
+      sorted.add(proxy);
+    } else {
+      unsorted.add(proxy);
+    }
+  }
+  sorted.sort((a, b) => orderIndex[a.name]!.compareTo(orderIndex[b.name]!));
+  return [...sorted, ...unsorted];
+}
