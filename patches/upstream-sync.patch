-static void print_lines(const char *source, int line, int line1) {
-    const char *s = source;
-    const char *p = skip_lines(s, line);
-    if (*p) {
-        while (line++ < line1) {
-            p = skip_lines(s = p, 1);
-            printf(";; %.*s", (int)(p - s), s);
-            if (!*p) {
-                if (p[-1] != '\n')
-                    printf("\n");
-                break;
-            }
-        }
-    }
