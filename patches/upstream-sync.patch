-    JSObject *p;
-    JSShapeProperty *prs;
-    JSProperty *pr;
-    int mask, res;
-
-    if (JS_VALUE_GET_TAG(this_obj) != JS_TAG_OBJECT) {
-        JS_ThrowTypeErrorNotAnObject(ctx);
-        return -1;
-    }
-    p = JS_VALUE_GET_OBJ(this_obj);
