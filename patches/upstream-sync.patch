-void check_cc_table(void)
-{
-    int cc, cc_ref, c;
-
-    for(c = 0; c <= CHARCODE_MAX; c++) {
-        cc_ref = unicode_db[c].combining_class;
-        cc = unicode_get_cc(c);
-        if (cc != cc_ref) {
-            printf("ERROR: c=%04x cc=%d cc_ref=%d\n",
-                   c, cc, cc_ref);
-            exit(1);
-        }
-    }
-#ifdef PROFILE
-    {
-        int64_t ti, count;
-    
-        ti = get_time_ns();
-        count = 0;
-        /* only do it on meaningful chars */
-        for(c = 0x20; c <= 0xffff; c++) {
-            cc_ref = unicode_db[c].combining_class;
-            cc = unicode_get_cc(c);
-            count++;
-        }
-        ti = get_time_ns() - ti;
-        printf("cc time=%0.1f ns/char\n",
-               (double)ti / count);
-    }
-#endif
-}
