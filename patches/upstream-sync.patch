+              Row(
+                children: [
+                  for (final item in values)
+                    Expanded(
+                      child: FocusStateBuilder(
+                        builder: (context, focused) {
+                          final active =
+                              enabled && (isEnabled?.call(item) ?? true);
+                          final color = item == value
+                              ? colorScheme.primary
+                              : colorScheme.onSurfaceVariant.withValues(
+                                  alpha: active ? 1 : 0.5,
+                                );
+                          final icon = iconOf?.call(item);
+                          final ring = focused && globalState.isAndroidTV;
+                          return DecoratedBox(
+                            position: DecorationPosition.foreground,
+                            decoration: BoxDecoration(
+                              borderRadius: BorderRadius.circular(15),
+                              border: ring
+                                  ? Border.all(
+                                      color: colorScheme.primary,
+                                      width: 2,
+                                    )
+                                  : null,
+                            ),
+                            child: InkWell(
+                              borderRadius: BorderRadius.circular(15),
+                              focusColor: toolFocusColor(context),
+                              onTap: active ? () => onChanged(item) : null,
+                              child: Center(
+                                child: icon != null
+                                    ? Icon(
+                                        icon,
+                                        size: 16,
+                                        color: color,
+                                        semanticLabel: labelOf(item),
+                                      )
+                                    : AnimatedDefaultTextStyle(
+                                        duration: const Duration(
+                                          milliseconds: 200,
+                                        ),
+                                        style: baseStyle.copyWith(
+                                          fontWeight: FontWeight.w600,
+                                          color: color,
+                                        ),
+                                        child: Text(
+                                          labelOf(item),
+                                          maxLines: 1,
+                                          overflow: TextOverflow.ellipsis,
+                                        ),
+                                      ),
+                              ),
+                            ),
+                          );
+                        },
+                      ),
+                    ),
+                ],
+              ),
+            ],
+          );
+        },
+      ),
+    );
+  }
+}
