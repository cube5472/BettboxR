-static int find_abbrev(JSString *sp, int p, const char *list, int count) {
-    int n, i;
-
-    if (p + 3 <= sp->len) {
-        for (n = 0; n < count; n++) {
-            for (i = 0; i < 3; i++) {
-                if (string_get(sp, p + i) != month_names[n * 3 + i])
-                    goto next;
-            }
-            return n;
-        next:;
-        }
-    }
-    return -1;
-}
