diff --git a/test/common/request_encoding_test.dart b/test/common/request_encoding_test.dart
new file mode 100644
index 00000000..0f39754c
--- /dev/null
+++ b/test/common/request_encoding_test.dart
@@ -0,0 +1,109 @@
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:bett_box/common/common.dart';
+import 'package:bett_box/state.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+
+const _content = 'mixed-port: 7890\nmode: rule\n';
+
+void main() {
+  late ServerSocket server;
+  late Directory home;
+  late String url;
+  final acceptEncodings = <String>[];
+  var duplicateEncoding = true;
+
+  void serve(Socket socket) {
+    final buffer = BytesBuilder();
+    var handled = false;
+    socket.listen((chunk) async {
+      if (handled) return;
+      buffer.add(chunk);
+      final head = latin1.decode(buffer.toBytes());
+      if (!head.contains('\r\n\r\n')) return;
+      handled = true;
+      final acceptEncoding =
+          RegExp(
+            r'^accept-encoding:\s*([^\r\n]*)',
+            caseSensitive: false,
+            multiLine: true,
+          ).firstMatch(head)?.group(1)?.trim() ??
+          '';
+      acceptEncodings.add(acceptEncoding);
+      final gzipped = acceptEncoding.contains('gzip');
+      final body = gzipped
+          ? gzip.encode(utf8.encode(_content))
+          : utf8.encode(_content);
+      final encodings = [
+        if (gzipped) 'gzip',
+        if (!gzipped || duplicateEncoding) 'identity',
+      ];
+      socket
+        ..add(
+          latin1.encode(
+            [
+              'HTTP/1.1 200 OK',
+              'Content-Type: text/plain',
+              for (final encoding in encodings) 'Content-Encoding: $encoding',
+              'Content-Length: ${body.length}',
+              'Connection: close',
+              '',
+              '',
+            ].join('\r\n'),
+          ),
+        )
+        ..add(body);
+      await socket.close();
+    }, onError: (_) {});
+  }
+
+  setUpAll(() async {
+    globalState.packageInfo = PackageInfo(
+      appName: 'Bettbox',
+      packageName: 'com.appshub.bettbox',
+      version: '1.0.0',
+      buildNumber: '1',
+    );
+    home = await Directory.systemTemp.createTemp('bettbox_request_');
+    server = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen(serve);
+    url = 'http://127.0.0.1:${server.port}/clash.yaml';
+  });
+
+  tearDownAll(() async {
+    await server.close();
+    await home.delete(recursive: true);
+  });
+
+  setUp(() {
+    acceptEncodings.clear();
+    duplicateEncoding = true;
+  });
+
+  test('content-encoding 多值时下载订阅改用 identity 重试', () async {
+    final path = '${home.path}/profile.download';
+    final source = await request.fetchProfileSource(url, path);
+
+    expect(acceptEncodings, ['gzip', 'identity']);
+    expect(source.headers?['content-encoding'], ['identity']);
+    expect(await File(path).readAsString(), _content);
+  });
+
+  test('content-encoding 多值时文本请求改用 identity 重试', () async {
+    final response = await request.getTextResponseForUrl(url);
+
+    expect(acceptEncodings, ['gzip', 'identity']);
+    expect(response.data, _content);
+  });
+
+  test('正常 gzip 响应不重试', () async {
+    duplicateEncoding = false;
+    final response = await request.getTextResponseForUrl(url);
+
+    expect(acceptEncodings, ['gzip']);
+    expect(response.data, _content);
+  });
+}
diff --git a/test/common/route_idle_observer_test.dart b/test/common/route_idle_observer_test.dart
new file mode 100644
index 00000000..1eda3085
--- /dev/null
+++ b/test/common/route_idle_observer_test.dart
@@ -0,0 +1,164 @@
+import 'package:bett_box/common/context.dart';
+import 'package:bett_box/common/navigator.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('转场与手势期间 busy，结束后 whenIdle 完成', (tester) async {
+    final observer = RouteIdleObserver();
+    final key = GlobalKey<NavigatorState>();
+    await tester.pumpWidget(
+      MaterialApp(
+        navigatorKey: key,
+        navigatorObservers: [observer],
+        home: const Scaffold(body: Text('home')),
+      ),
+    );
+    expect(observer.busy.value, isFalse);
+    await observer.whenIdle();
+
+    key.currentState!.push(
+      MaterialPageRoute<void>(builder: (_) => const Scaffold(body: Text('b'))),
+    );
+    await tester.pump();
+    expect(observer.busy.value, isTrue);
+    await tester.pump(const Duration(milliseconds: 50));
+    expect(observer.busy.value, isTrue);
+    await tester.pumpAndSettle();
+    expect(observer.busy.value, isFalse);
+
+    key.currentState!.pop();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 50));
+    expect(observer.busy.value, isTrue);
+
+    var idle = false;
+    observer.whenIdle().then((_) => idle = true);
+    await tester.pump();
+    expect(idle, isFalse);
+    await tester.pumpAndSettle();
+    expect(observer.busy.value, isFalse);
+    expect(idle, isTrue);
+
+    observer.didStartUserGesture(
+      MaterialPageRoute<void>(builder: (_) => const SizedBox()),
+      null,
+    );
+    expect(observer.busy.value, isTrue);
+    observer.didStopUserGesture();
+    expect(observer.busy.value, isFalse);
+  });
+
+  testWidgets('页面退场期间及刚结束时未稳定，稍后才算稳定', (tester) async {
+    final observer = RouteIdleObserver();
+    final key = GlobalKey<NavigatorState>();
+    await tester.pumpWidget(
+      MaterialApp(
+        navigatorKey: key,
+        navigatorObservers: [observer],
+        home: const Scaffold(body: Text('home')),
+      ),
+    );
+    key.currentState!.push(
+      MaterialPageRoute<void>(builder: (_) => const Scaffold(body: Text('b'))),
+    );
+    await tester.pumpAndSettle();
+    await tester.runAsync(
+      () => Future<void>.delayed(const Duration(milliseconds: 300)),
+    );
+    expect(observer.isSettled, isTrue);
+
+    key.currentState!.pop();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 50));
+    expect(observer.busy.value, isTrue);
+    expect(observer.isSettled, isFalse);
+
+    await tester.pumpAndSettle();
+    expect(observer.busy.value, isFalse);
+    expect(observer.isSettled, isFalse);
+
+    await tester.runAsync(
+      () => Future<void>.delayed(const Duration(milliseconds: 300)),
+    );
+    expect(observer.isSettled, isTrue);
+  });
+
+  testWidgets('无动画的出栈同样需要等待稳定', (tester) async {
+    final observer = RouteIdleObserver();
+    final key = GlobalKey<NavigatorState>();
+    await tester.pumpWidget(
+      MaterialApp(
+        navigatorKey: key,
+        navigatorObservers: [observer],
+        home: const Scaffold(body: Text('home')),
+      ),
+    );
+    key.currentState!.push(
+      PageRouteBuilder<void>(
+        pageBuilder: (_, _, _) => const Scaffold(body: Text('b')),
+        transitionDuration: Duration.zero,
+        reverseTransitionDuration: Duration.zero,
+      ),
+    );
+    await tester.pumpAndSettle();
+    await tester.runAsync(
+      () => Future<void>.delayed(const Duration(milliseconds: 300)),
+    );
+    expect(observer.isSettled, isTrue);
+
+    key.currentState!.pop();
+    await tester.pumpAndSettle();
+    expect(observer.busy.value, isFalse);
+    expect(observer.isSettled, isFalse);
+  });
+
+  testWidgets('afterRouteTransition 在进入动画结束后才执行', (tester) async {
+    final key = GlobalKey<NavigatorState>();
+    await tester.pumpWidget(
+      MaterialApp(
+        navigatorKey: key,
+        home: const Scaffold(body: Text('home')),
+      ),
+    );
+    var called = 0;
+    key.currentState!.push(
+      MaterialPageRoute<void>(
+        builder: (_) => _AfterTransitionProbe(onReady: () => called++),
+      ),
+    );
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 50));
+    expect(called, 0);
+
+    await tester.pumpAndSettle();
+    expect(called, 1);
+
+    final context = tester.element(find.byType(_AfterTransitionProbe));
+    context.afterRouteTransition(() => called++);
+    expect(called, 2);
+  });
+}
+
+class _AfterTransitionProbe extends StatefulWidget {
+  final VoidCallback onReady;
+
+  const _AfterTransitionProbe({required this.onReady});
+
+  @override
+  State<_AfterTransitionProbe> createState() => _AfterTransitionProbeState();
+}
+
+class _AfterTransitionProbeState extends State<_AfterTransitionProbe> {
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (!mounted) return;
+      context.afterRouteTransition(widget.onReady);
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) => const Scaffold(body: Text('probe'));
+}
