-    for (final segment in grammarSegments) {
-      final segmentEnd = offset + segment.text.length;
-      if (position >= offset && position < segmentEnd) {
-        return segment.style;
-      }
-      offset = segmentEnd;
-    }
-    return baseTextStyle;
-  }
