diff --git a/test/common/navigator_test.dart b/test/common/navigator_test.dart
new file mode 100644
index 00000000..95b067d7
--- /dev/null
+++ b/test/common/navigator_test.dart
@@ -0,0 +1,69 @@
+import 'package:bett_box/common/common.dart';
+import 'package:bett_box/models/models.dart';
+import 'package:bett_box/state.dart';
+import 'package:cupertino_ui/cupertino_ui.dart'
+    show CupertinoPageTransitionsBuilder;
+import 'package:flutter/gestures.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('提示气泡显示时推入页面不触发布局期间的子树迁移', (tester) async {
+    globalState.appState = AppState(
+      brightness: Brightness.light,
+      version: 0,
+      viewSize: const Size(400, 800),
+      requests: FixedList(maxLength),
+      logs: FixedList(maxLogLength),
+      traffics: FixedList(30),
+      totalTraffic: Traffic(),
+      systemUiOverlayStyle: const SystemUiOverlayStyle(),
+    );
+    await tester.pumpWidget(
+      MaterialApp(
+        theme: ThemeData(
+          pageTransitionsTheme: const PageTransitionsTheme(
+            builders: <TargetPlatform, PageTransitionsBuilder>{
+              TargetPlatform.android: CupertinoPageTransitionsBuilder(),
+            },
+          ),
+        ),
+        builder: (_, child) => LayoutBuilder(builder: (_, _) => child!),
+        home: Builder(
+          builder: (context) => Scaffold(
+            body: IconButton(
+              tooltip: 'tip',
+              onPressed: () => BaseNavigator.push(
+                context,
+                const Scaffold(body: Text('next')),
+              ),
+              icon: const Text('open'),
+            ),
+          ),
+        ),
+      ),
+    );
+    final gesture = await tester.createGesture(kind: PointerDeviceKind.mouse);
+    await gesture.addPointer(location: Offset.zero);
+    addTearDown(gesture.removePointer);
+    await gesture.moveTo(tester.getCenter(find.text('open')));
+    await tester.pump(const Duration(milliseconds: 600));
+    expect(find.text('tip'), findsOneWidget);
+    final homeLeft = tester.getTopLeft(find.text('open')).dx;
+
+    await gesture.down(tester.getCenter(find.text('open')));
+    await gesture.up();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 200));
+    expect(tester.takeException(), isNull);
+    expect(tester.getTopLeft(find.text('open')).dx, lessThan(homeLeft));
+
+    await tester.pumpAndSettle();
+    expect(find.text('next'), findsOneWidget);
+    tester.state<NavigatorState>(find.byType(Navigator)).pop();
+    await tester.pumpAndSettle();
+    expect(tester.takeException(), isNull);
+    expect(tester.getTopLeft(find.text('open')).dx, homeLeft);
+  });
+}
diff --git a/test/common/network_detection_test.dart b/test/common/network_detection_test.dart
new file mode 100644
index 00000000..0685832f
--- /dev/null
+++ b/test/common/network_detection_test.dart
@@ -0,0 +1,141 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:bett_box/common/common.dart';
+import 'package:bett_box/enum/enum.dart';
+import 'package:bett_box/models/models.dart';
+import 'package:bett_box/state.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+Future<void> _waitFor(bool Function() condition) async {
+  final deadline = DateTime.now().add(const Duration(seconds: 5));
+  while (!condition()) {
+    if (DateTime.now().isAfter(deadline)) {
+      fail('condition not met in time');
+    }
+    await Future.delayed(const Duration(milliseconds: 20));
+  }
+}
+
+void main() {
+  late HttpServer server;
+  final pending = <Completer<void>>[];
+  var requestCount = 0;
+
+  void setConfig({Mode mode = Mode.rule}) {
+    globalState.config = Config(
+      themeProps: defaultThemeProps,
+      appSetting: const AppSettingProps(
+        mobileDashboardWidgets: [],
+        desktopDashboardWidgets: [],
+      ),
+      patchClashConfig: ClashConfig(mixedPort: server.port, mode: mode),
+    );
+  }
+
+  void setAppState({required bool isInit}) {
+    globalState.appState = AppState(
+      isInit: isInit,
+      runTime: 1,
+      brightness: Brightness.light,
+      version: 0,
+      viewSize: Size.zero,
+      requests: FixedList(maxLength),
+      logs: FixedList(maxLogLength),
+      traffics: FixedList(30),
+      totalTraffic: Traffic(),
+      systemUiOverlayStyle: const SystemUiOverlayStyle(),
+    );
+  }
+
+  void release() {
+    for (final completer in pending) {
+      completer.complete();
+    }
+    pending.clear();
+  }
+
+  setUpAll(() async {
+    HttpOverrides.global = BettboxHttpOverrides();
+    server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen((request) async {
+      if (request.method != 'GET') {
+        request.response.statusCode = HttpStatus.badGateway;
+        await request.response.close();
+        return;
+      }
+      requestCount++;
+      final completer = Completer<void>();
+      pending.add(completer);
+      await completer.future;
+      request.response.write(
+        json.encode({
+          'status': 'success',
+          'query': '1.2.3.4',
+          'countryCode': 'US',
+        }),
+      );
+      await request.response.close().catchError((_) {});
+    });
+  });
+
+  tearDownAll(() async {
+    release();
+    await server.close(force: true);
+  });
+
+  setUp(() {
+    requestCount = 0;
+    setConfig();
+    setAppState(isInit: true);
+  });
+
+  tearDown(() async {
+    release();
+    await _waitFor(() => !detectionState.state.value.isLoading);
+  });
+
+  test('进行中的检测不会被相同条件的触发重启', () async {
+    detectionState.startCheck(immediate: true);
+    await _waitFor(() => requestCount == 1);
+
+    detectionState.startCheck(immediate: true);
+    await Future.delayed(const Duration(milliseconds: 300));
+    expect(requestCount, 1);
+
+    release();
+    await _waitFor(() => detectionState.state.value.ipInfo?.ip == '1.2.3.4');
+    expect(detectionState.state.value.isLoading, isFalse);
+  });
+
+  test('初始化前的触发在初始化完成后补发', () async {
+    setAppState(isInit: false);
+    detectionState.startCheck(immediate: true);
+    await Future.delayed(const Duration(milliseconds: 300));
+    expect(requestCount, 0);
+
+    setAppState(isInit: true);
+    detectionState.flushPendingCheck();
+    await _waitFor(() => requestCount == 1);
+
+    detectionState.flushPendingCheck();
+    release();
+    await _waitFor(() => !detectionState.state.value.isLoading);
+    await Future.delayed(const Duration(milliseconds: 2300));
+    expect(requestCount, 1);
+  });
+
+  test('条件变化时重启检测', () async {
+    detectionState.startCheck(immediate: true);
+    await _waitFor(() => requestCount == 1);
+
+    setConfig(mode: Mode.global);
+    detectionState.startCheck(immediate: true);
+    await _waitFor(() => requestCount == 2);
+
+    release();
+    await _waitFor(() => detectionState.state.value.ipInfo?.ip == '1.2.3.4');
+  });
+}
