-            /* replace the iteration object with undefined */
-            JS_FreeValue(ctx, sp[offset]);
-            sp[offset] = JS_UNDEFINED;
-            if (done < 0) {
-                return -1;
-            } else {
-                JS_FreeValue(ctx, value);
-                value = JS_UNDEFINED;
-            }
-        }
-    }
-    sp[0] = value;
-    sp[1] = JS_NewBool(ctx, done);
-    return 0;
