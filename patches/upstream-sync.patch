+  Future<String?> _resolveSystemDnsFallback() async {
+    try {
+      final addresses = await InternetAddress.lookup('mensura.cdn-apple.com');
+      for (final addr in addresses) {
+        if (utils.classifyIp(addr.address) == IpCategory.public) {
+          return addr.address;
+        }
+      }
+    } catch (_) {}
+    try {
