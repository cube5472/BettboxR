+          position.jumpTo(random.nextDouble() * position.maxScrollExtent);
+          await tester.pump(Duration(milliseconds: random.nextInt(20)));
+        }
+        expect(tester.takeException(), isNull, reason: 'step $i');
+      }
+    });
+  }
