-/* 0 <= c <= 0x10ffff */
-static int string_buffer_putc(StringBuffer *s, uint32_t c)
-{
-    if (unlikely(c >= 0x10000)) {
-        /* surrogate pair */
-        c -= 0x10000;
-        if (string_buffer_putc16(s, (c >> 10) + 0xd800))
-            return -1;
-        c = (c & 0x3ff) + 0xdc00;
-    }
-    return string_buffer_putc16(s, c);
-}
