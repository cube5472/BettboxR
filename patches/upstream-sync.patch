-        } else if (b < 0x60) {
-            c += (((b - 0x40) << 8) | p[0]) + 1;
-            p++;
-        } else {
-            c += (((b - 0x60) << 16) | (p[0] << 8) | p[1]) + 1;
-            p += 2;
-        }
-        if (bit)  {
-            if (cr_add_interval(cr, c0, c))
-                return -1;
-        }
-        bit ^= 1;
-    }
-    return 0;
