-static int bc_get_buf(BCReaderState *s, uint8_t *buf, uint32_t buf_len)
-{
-    if (buf_len != 0) {
-        if (unlikely(!buf || s->buf_end - s->ptr < buf_len))
-            return bc_read_error_end(s);
-        memcpy(buf, s->ptr, buf_len);
-        s->ptr += buf_len;
