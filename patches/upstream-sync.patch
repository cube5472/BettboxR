+const _blockLines = 6;
+
+String _block(int i) =>
+    '''
+  - name: node $i
+    type: vmess
+    server: ${'s' * 40}.example$i.com
+    opts: {
+      path: /
+    }''';
+
+String _document(int blocks) =>
+    ['proxies:', for (var i = 0; i < blocks; i++) _block(i)].join('\n');
+
+int _optsLine(int block) => 1 + block * _blockLines + 3;
