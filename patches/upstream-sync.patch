+func parsePatchProfile(t *testing.T, content string) *config.RawConfig {
+	t.Helper()
+	rawCfg, err := config.UnmarshalRawConfig([]byte(content))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return rawCfg
+}
