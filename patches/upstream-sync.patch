+      proxiesStyleSettingProvider.select((state) => state.sortType),
+    );
+    if (sortType == ProxiesSortType.none) return _lastSorted = proxies;
+    if (sortType == ProxiesSortType.custom) {
+      // Ручной порядок: следим за сохранённым списком группы; новые и
+      // переименованные ноды добавляются в конец (sortProxiesByOrder).
+      final order = ref.watch(
+        proxiesStyleSettingProvider.select(
+          (state) => state.proxyOrders[groupName] ?? const <String>[],
+        ),
