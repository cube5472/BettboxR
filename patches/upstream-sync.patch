+List<(ui.Paragraph, Offset)> _paintedParagraphs(WidgetTester tester) {
+  final painted = <(ui.Paragraph, Offset)>[];
+  expect(
+    _renderer(tester),
+    paints..everything((method, args) {
+      if (method == #drawParagraph) {
+        painted.add((args[0] as ui.Paragraph, args[1] as Offset));
+      }
+      return true;
+    }),
+  );
+  return painted;
