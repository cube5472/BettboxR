-/* Note: the integer value is satured to 32 bits */
-static int JS_ToInt32SatFree(JSContext *ctx, int *pres, JSValue val)
-{
-    uint32_t tag;
-    int ret;
-
- redo:
-    tag = JS_VALUE_GET_NORM_TAG(val);
