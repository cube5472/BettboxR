+class ToolsShortcut {
+  final Widget icon;
+  final String title;
+  final String? subtitle;
+  final WidgetBuilder? builder;
+  final VoidCallback? onTap;
+  final bool wrap;
+
+  const ToolsShortcut({
+    required this.icon,
+    required this.title,
+    this.subtitle,
+    this.builder,
+    this.onTap,
+    this.wrap = true,
+  });
+
+  void open(BuildContext context) {
+    final builder = this.builder;
+    if (builder == null) {
+      onTap?.call();
+      return;
+    }
+    showExtend(
+      context,
+      props: const ExtendProps(forceFull: true),
+      builder: (_, type) {
+        final child = builder(context);
+        return wrap
+            ? AdaptiveSheetScaffold(type: type, title: title, body: child)
+            : child;
+      },
+    );
+  }
+}
