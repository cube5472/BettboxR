+  void _handleEnter() {
+    _timer?.cancel();
+    if (_portalController.isShowing) {
+      _animationController.forward();
+      return;
+    }
+    final delay = ref.read(appSettingProvider).sidebarFlyoutDelay.duration;
+    _timer = Timer(delay, () {
+      _portalController.show();
+      _animationController.forward();
+    });
