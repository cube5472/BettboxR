-    JSObject *p;
-    JSProperty *pr;
-
-    if (JS_VALUE_GET_TAG(this_obj) != JS_TAG_OBJECT)
-        return FALSE;
-
-    p = JS_VALUE_GET_OBJ(this_obj);
-
-    if (find_own_property(&pr, p, prop)) {
-        /* property already exists */
-        abort();
-        return FALSE;
