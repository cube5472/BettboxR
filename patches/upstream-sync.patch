+          'skip',
+        ],
+      }),
+    );
+    expect(parsed.name, 'Qure-Style-SVG');
+    expect(parsed.icons.map((icon) => icon.name), [
+      'Hong_Kong.svg',
+      'Available(1).svg',
+    ]);
+    expect(parsed.icons.first.label, 'Hong Kong');
+    expect(
+      const IconSetIcon(name: 'Apple_Fitness%2B.svg', url: '').label,
+      'Apple Fitness+',
