-    final current = _suggestionNotifier.value;
-    if (current == null) return;
-    final withoutSnippets = current
-        .where((e) => e is! _SnippetSuggestion)
-        .toList();
-    if (withoutSnippets.length == current.length) return;
-    _isInjectingSnippets = true;
