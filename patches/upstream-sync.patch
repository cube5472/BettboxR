-/* return label or -1 if dead code */
-static int emit_goto(JSParseState *s, int opcode, int label)
-{
-    if (js_is_live_code(s)) {
-        if (label < 0)
-            label = new_label(s);
-        emit_op(s, opcode);
-        emit_u32(s, label);
-        s->cur_func->label_slots[label].ref_count++;
-        return label;
-    }
-    return -1;
-}
