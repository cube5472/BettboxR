-  static List<String>? _extractKeywordsFromRegex(String regex) {
-    final groupMatch = RegExp(
-      r'(?:\\b)?\(?(?:\?[:<>=!][^)]*\))?(?:\\b)?\((?:\?:|\?<[!=][^)]*\))?\s*([^)]+)\)(?:\\b)?',
-    ).firstMatch(regex);
