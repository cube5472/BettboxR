-static int string_buffer_write8(StringBuffer *s, const uint8_t *p, int len)
-{
-    int i;
-
-    if (s->len + len > s->size) {
-        if (string_buffer_realloc(s, s->len + len, 0))
-            return -1;
-    }
-    if (s->is_wide_char) {
-        for (i = 0; i < len; i++) {
-            s->str->u.str16[s->len + i] = p[i];
-        }
-        s->len += len;
-    } else {
-        memcpy(&s->str->u.str8[s->len], p, len);
-        s->len += len;
-    }
-    return 0;
-}
