-    for (var i = 0; i < regex.length; i++) {
-      if (regex[i] == '\\' && i + 1 < regex.length) {
-        i++;
-        continue;
-      }
-
-      if (regex[i] == '(') {
-        if (depth == 0) {
-          isNonCapturing = false;
-          if (i + 1 < regex.length && regex[i + 1] == '?') {
-            isNonCapturing = true;
