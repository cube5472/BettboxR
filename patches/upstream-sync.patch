-
-    for (;;) {
-        if (s->token.val == TOK_IDENT) {
-            if (s->token.u.ident.is_reserved) {
-                return js_parse_error_reserved_identifier(s);
-            }
-            name = JS_DupAtom(ctx, s->token.u.ident.atom);
