+  WidgetTester tester,
+  LogicalKeyboardKey key,
+  int times,
+) async {
+  final visited = <String>[];
+  for (var i = 0; i < times; i++) {
+    await tester.sendKeyEvent(key);
+    await tester.pumpAndSettle();
+    visited.add(_focused());
+  }
+  return visited;
