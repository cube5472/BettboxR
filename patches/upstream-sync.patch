-static uint32_t unicode_get_short_code(uint32_t c)
-{
-    static const uint16_t unicode_short_table[2] = { 0x2044, 0x2215 };
-
-    if (c < 0x80)
-        return c;
-    else if (c < 0x80 + 0x50)
-        return c - 0x80 + 0x300;
-    else
-        return unicode_short_table[c - 0x80 - 0x50];
-}
