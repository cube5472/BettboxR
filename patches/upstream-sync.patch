-/* 0 <= c <= 0xffff */
-static int string_buffer_putc16(StringBuffer *s, uint32_t c)
-{
-    if (likely(s->len < s->size)) {
-        if (s->is_wide_char) {
-            s->str->u.str16[s->len++] = c;
-            return 0;
-        } else if (c < 0x100) {
-            s->str->u.str8[s->len++] = c;
-            return 0;
-        }
