-        } else {
-            goto def_token;
-        }
-        break;
-    case '+':
-        if (p[1] == '=') {
-            p += 2;
-            s->token.val = TOK_PLUS_ASSIGN;
-        } else if (p[1] == '+') {
-            p += 2;
-            s->token.val = TOK_INC;
-        } else {
-            goto def_token;
-        }
-        break;
-    case '-':
-        if (p[1] == '=') {
-            p += 2;
-            s->token.val = TOK_MINUS_ASSIGN;
-        } else if (p[1] == '-') {
-            if (s->allow_html_comments &&
-                p[2] == '>' && s->last_line_num != s->line_num) {
-                /* Annex B: `-->` at beginning of line is an html comment end.
-                   It extends to the end of the line.
