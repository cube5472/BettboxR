-                    goto redo;
-                } else {
-                    return FALSE;
-                }
-            }
-        } else {
-            const JSClassExoticMethods *em = ctx->rt->class_array[p->class_id].exotic;
-            if (em && em->delete_property) {
-                return em->delete_property(ctx, JS_MKPTR(JS_TAG_OBJECT, p), atom);
-            }
-        }
-    }
-    /* not found */
-    return TRUE;
-}
