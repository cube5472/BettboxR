-    case JS_TAG_FLOAT64:
-        d1 = JS_VALUE_GET_FLOAT64(op1);
-        if (tag2 == JS_TAG_FLOAT64) {
-            d2 = JS_VALUE_GET_FLOAT64(op2);
-        } else if (tag2 == JS_TAG_INT) {
-            d2 = JS_VALUE_GET_INT(op2);
-        } else {
-            res = FALSE;
-            break;
-        }
