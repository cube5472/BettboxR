-static const uint32_t unicode_gc_mask_table[] = {
-    M(Lu) | M(Ll) | M(Lt), /* LC */
-    M(Lu) | M(Ll) | M(Lt) | M(Lm) | M(Lo), /* L */
-    M(Mn) | M(Mc) | M(Me), /* M */
-    M(Nd) | M(Nl) | M(No), /* N */
-    M(Sm) | M(Sc) | M(Sk) | M(So), /* S */
-    M(Pc) | M(Pd) | M(Ps) | M(Pe) | M(Pi) | M(Pf) | M(Po), /* P */
-    M(Zs) | M(Zl) | M(Zp), /* Z */
-    M(Cc) | M(Cf) | M(Cs) | M(Co) | M(Cn), /* C */
-};
