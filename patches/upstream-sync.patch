+    await pumpEditor(tester, controller);
+
+    controller.toggleFold(_optsLine(1));
+    await settle(tester);
+    expect(controller.text, text);
+    expect(controller.isLineInFoldedRegion(_optsLine(1) + 1), isTrue);
