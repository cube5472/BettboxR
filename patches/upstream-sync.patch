-static int unicode_prop1(CharRange *cr, int prop_idx)
-{
-    const uint8_t *p, *p_end;
-    uint32_t c, c0, b, bit;
-
-    p = unicode_prop_table[prop_idx];
-    p_end = p + unicode_prop_len_table[prop_idx];
-    c = 0;
-    bit = 0;
-    while (p < p_end) {
-        c0 = c;
-        b = *p++;
-        if (b < 64) {
-            c += (b >> 3) + 1;
-            if (bit)  {
-                if (cr_add_interval(cr, c0, c))
-                    return -1;
-            }
