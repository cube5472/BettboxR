-static int js_parse_expect_semi(JSParseState *s)
-{
-    if (s->token.val != ';') {
-        /* automatic insertion of ';' */
-        if (s->token.val == TOK_EOF || s->token.val == '}' || s->got_lf) {
-            return 0;
-        }
-        return js_parse_error(s, "expecting '%c'", ';');
-    }
-    return next_token(s);
