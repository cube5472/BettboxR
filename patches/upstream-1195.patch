-            case LineDecorationType.wavyUnderline:
-              paint.style = PaintingStyle.stroke;
-              paint.strokeWidth = decoration.thickness;
-              final width =
-                  size.width - _gutterWidth - (innerPadding?.horizontal ?? 0);
