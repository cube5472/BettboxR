-int find_name(const char **tab, int tab_len, const char *name)
-{
-    int i, len, name_len;
-    const char *p, *r;
-
-    name_len = strlen(name);
-    for(i = 0; i < tab_len; i++) {
-        p = tab[i];
-        for(;;) {
-            r = strchr(p, ',');
-            if (!r)
-                len = strlen(p);
-            else
-                len = r - p;
-            if (len == name_len && memcmp(p, name, len) == 0)
-                return i;
-            if (!r)
-                break;
-            p = r + 1;
-        }
-    }
-    return -1;
-}
