new file mode 100644
index 0000000..21e3ed0
--- /dev/null
+++ b/plugins/code_forge/rust/src/script/console.rs
@@ -0,0 +1,72 @@
+use rquickjs::function::Rest;
+use rquickjs::{Ctx, Function, Object, Result, Value};
+use std::cell::RefCell;
+use std::rc::Rc;
+
+const LEVELS: [&str; 6] = ["log", "info", "warn", "error", "debug", "trace"];
+const MAX_LINES: usize = 200;
+const MAX_BYTES: usize = 64 * 1024;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct LogLine {
+    pub level: String,
+    pub text: String,
+}
+
+#[derive(Default)]
+pub struct LogBuffer {
+    lines: Vec<LogLine>,
+    bytes: usize,
+}
+
+impl LogBuffer {
+    fn push(&mut self, level: &str, text: String) {
+        if self.lines.len() >= MAX_LINES || self.bytes + text.len() > MAX_BYTES {
+            return;
+        }
+        self.bytes += text.len();
+        self.lines.push(LogLine {
+            level: level.to_owned(),
+            text,
+        });
+    }
+
+    pub fn take(&mut self) -> Vec<LogLine> {
+        self.bytes = 0;
+        std::mem::take(&mut self.lines)
+    }
+}
+
+pub type SharedLogs = Rc<RefCell<LogBuffer>>;
+
+pub fn install(ctx: &Ctx<'_>, logs: Option<SharedLogs>) -> Result<()> {
+    let console = Object::new(ctx.clone())?;
+    for level in LEVELS {
+        let logs = logs.clone();
+        let print = Function::new(ctx.clone(), move |ctx, args| write(&logs, level, ctx, args))?;
+        console.set(level, print)?;
+    }
+    ctx.globals().set("console", console)
+}
+
+fn write<'js>(logs: &Option<SharedLogs>, level: &str, ctx: Ctx<'js>, args: Rest<Value<'js>>) {
+    let Some(logs) = logs else {
+        return;
+    };
+    let line = args
+        .iter()
+        .map(|value| format(&ctx, value))
+        .collect::<Vec<_>>()
+        .join(" ");
+    logs.borrow_mut().push(level, line);
+}
+
+fn format<'js>(ctx: &Ctx<'js>, value: &Value<'js>) -> String {
+    if let Some(text) = value.as_string() {
+        return text.to_string().unwrap_or_default();
+    }
+    match ctx.json_stringify(value.clone()) {
+        Ok(Some(json)) => json.to_string().unwrap_or_default(),
+        _ => format!("{value:?}"),
+    }
+}
diff --git a/plugins/code_forge/rust/src/script/convert.rs b/plugins/code_forge/rust/src/script/convert.rs
new file mode 100644
index 0000000..cda7e4d
--- /dev/null
+++ b/plugins/code_forge/rust/src/script/convert.rs
@@ -0,0 +1,86 @@
+use rquickjs::{Array, Ctx, Object, Result, Type, Value};
+use serde_json::{Map, Number, Value as Json};
+
+const MAX_DEPTH: usize = 128;
+const MAX_SAFE_INTEGER: f64 = 9_007_199_254_740_991.0;
+
+fn too_deep(from: &'static str) -> rquickjs::Error {
+    rquickjs::Error::new_from_js(from, "a config nested within the depth limit")
+}
+
+pub fn to_js<'js>(ctx: &Ctx<'js>, json: &Json, depth: usize) -> Result<Value<'js>> {
+    if depth > MAX_DEPTH {
+        return Err(too_deep("json"));
+    }
+    Ok(match json {
+        Json::Null => Value::new_null(ctx.clone()),
+        Json::Bool(value) => Value::new_bool(ctx.clone(), *value),
+        Json::Number(number) => match number.as_i64().and_then(|value| i32::try_from(value).ok()) {
+            Some(value) => Value::new_int(ctx.clone(), value),
+            None => Value::new_float(ctx.clone(), number.as_f64().unwrap_or(f64::NAN)),
+        },
+        Json::String(text) => rquickjs::String::from_str(ctx.clone(), text)?.into_value(),
+        Json::Array(items) => {
+            let array = Array::new(ctx.clone())?;
+            for (index, item) in items.iter().enumerate() {
+                array.set(index, to_js(ctx, item, depth + 1)?)?;
+            }
+            array.into_value()
+        }
+        Json::Object(map) => {
+            let object = Object::new(ctx.clone())?;
+            for (key, value) in map {
+                object.set(key.as_str(), to_js(ctx, value, depth + 1)?)?;
+            }
+            object.into_value()
+        }
+    })
+}
+
+pub fn from_js(value: &Value<'_>, depth: usize) -> Result<Json> {
+    if depth > MAX_DEPTH {
+        return Err(too_deep("object"));
+    }
+    Ok(match value.type_of() {
+        Type::Bool => Json::Bool(value.as_bool().unwrap_or_default()),
+        Type::Int => Json::Number(value.as_int().unwrap_or_default().into()),
+        Type::Float => {
+            let float = value.as_float().unwrap_or_default();
+            if float.fract() == 0.0 && float.abs() <= MAX_SAFE_INTEGER {
+                Json::Number((float as i64).into())
+            } else {
+                Number::from_f64(float)
+                    .map(Json::Number)
+                    .unwrap_or(Json::Null)
+            }
+        }
+        Type::String => match value.as_string() {
+            Some(text) => Json::String(text.to_string()?),
+            None => Json::Null,
+        },
+        Type::Array => {
+            let mut items = Vec::new();
+            if let Some(array) = value.as_array() {
+                items.reserve(array.len());
+                for item in array.iter::<Value>() {
+                    items.push(from_js(&item?, depth + 1)?);
+                }
+            }
+            Json::Array(items)
+        }
+        Type::Object => {
+            let mut map = Map::new();
+            if let Some(object) = value.as_object() {
+                for entry in object.props::<String, Value>() {
+                    let (key, item) = entry?;
+                    if item.is_undefined() || item.is_function() {
+                        continue;
+                    }
+                    map.insert(key, from_js(&item, depth + 1)?);
+                }
+            }
+            Json::Object(map)
+        }
+        _ => Json::Null,
+    })
+}
