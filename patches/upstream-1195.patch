-        if (!hasval) {
-            emit_op(s, OP_undefined);
-        } else if (s->cur_func->func_kind == JS_FUNC_ASYNC_GENERATOR) {
-            emit_op(s, OP_await);
-        }
-        emit_op(s, OP_return_async);
-    } else {
-        emit_op(s, hasval ? OP_return : OP_return_undef);
-    }
-}
