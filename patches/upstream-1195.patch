-    dns[key] = list;
-  }
-
-  ensure('nameserver', kRfReachableDoTDns);
-  ensure('proxy-server-nameserver', kRfReachableDoTDns);
-  ensure('default-nameserver', kRfReachablePlainDns);
-}
