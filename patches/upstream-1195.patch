-static JSAtom JS_DupAtomRT(JSRuntime *rt, JSAtom v)
-{
-    JSAtomStruct *p;
-
-    if (!__JS_AtomIsConst(v)) {
-        p = rt->atom_array[v];
-        p->header.ref_count++;
-    }
