-                return JS_SetPropertyValue(ctx, this_obj, JS_NewInt32(ctx, idx), JS_DupValue(ctx, val), flags);
-            }
-            return TRUE;
-        typed_array_done: ;
-        }
-    }
-
-    return JS_CreateProperty(ctx, p, prop, val, getter, setter, flags);
