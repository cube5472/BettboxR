-                n = b;
-            } else if (b < 128 + 64) {
-                n = (b - 128) << 8;
-                n |= *p++;
-                n += 128;
-            } else {
-                n = (b - 128 - 64) << 16;
-                n |= *p++ << 8;
-                n |= *p++;
-                n += 128 + (1 << 14);
