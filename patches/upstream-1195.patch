+                level: "warn".to_owned(),
+                text: "careful".to_owned()
+            },
+        ]
+    );
+}
+
+#[test]
+fn keeps_console_output_when_the_script_fails() {
+    let failure = run(
+        "function main() { console.log('before'); throw new Error('boom') }",
+        json!({}),
+    )
+    .unwrap_err();
+
+    assert_eq!(failure.logs.len(), 1);
