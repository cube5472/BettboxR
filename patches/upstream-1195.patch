-                if (JS_IsFunction(ctx, getter)) {
-                    new_getter = JS_VALUE_GET_OBJ(getter);
-                } else {
-                    new_getter = NULL;
-                }
-                if (JS_IsFunction(ctx, setter)) {
-                    new_setter = JS_VALUE_GET_OBJ(setter);
-                } else {
-                    new_setter = NULL;
