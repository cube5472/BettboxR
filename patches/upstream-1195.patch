-static no_inline int js_not_slow(JSContext *ctx, JSValue *sp)
-{
-    JSValue op1, val;
-    int ret;
-    
-    op1 = sp[-1];
-    if (JS_IsObject(op1)) {
-        ret = js_call_unary_op_fallback(ctx, &val, op1, OP_not);
