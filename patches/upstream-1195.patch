-    atom1_is_integer = JS_AtomIsArrayIndex(ctx, &v1, atom1);
-    atom2_is_integer = JS_AtomIsArrayIndex(ctx, &v2, atom2);
-    assert(atom1_is_integer && atom2_is_integer);
-    if (v1 < v2)
-        return -1;
-    else if (v1 == v2)
