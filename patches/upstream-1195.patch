-          switch (decoration.type) {
-            case LineDecorationType.background:
-              final width =
-                  size.width - _gutterWidth - (innerPadding?.horizontal ?? 0);
-              canvas.drawRect(
-                Rect.fromLTWH(screenX, screenY, width, lineHeight),
-                paint,
-              );
-              break;
