-    emit_label(s, label_break);
-    if (is_for_of) {
-        /* close and drop enum_rec */
-        emit_op(s, OP_iterator_close);
-    } else {
-        emit_op(s, OP_drop);
-    }
-    pop_break_entry(s->cur_func);
-    pop_scope(s);
-    return 0;
-}
