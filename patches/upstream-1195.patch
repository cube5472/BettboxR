+  void _drawBracketBox(
+    Canvas canvas,
+    Offset offset,
+    int bracketOffset,
+    int lineIndex,
+    Color textColor,
+  ) {
+    final lineStartOffset = controller.getLineStartOffset(lineIndex);
+    final columnIndex = bracketOffset - lineStartOffset;
