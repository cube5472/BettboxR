+
+  // [markEmptyLines] gives a line the range crosses without covering any of
+  // its text a short block at its end, so the line break reads as selected.
+  void _drawRangeRows(
+    Canvas canvas,
+    Offset offset,
+    int start,
+    int end,
+    int startLine,
+    int endLine,
+    Paint paint, {
+    bool markEmptyLines = false,
