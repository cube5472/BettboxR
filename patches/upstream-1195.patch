-void build_script_ext_table(FILE *f)
-{
-    int i, j, n, n1, script_ext_len;
-    DynBuf dbuf_s, *dbuf = &dbuf_s;
-    int cw_count;
-
-    dbuf_init(dbuf);
-    cw_count = 0;
-    for(i = 0; i <= CHARCODE_MAX;) {
-        script_ext_len = unicode_db[i].script_ext_len;
