-static int JS_WriteObjectRec(BCWriterState *s, JSValueConst obj)
-{
-    uint32_t tag;
-
-    if (js_check_stack_overflow(s->ctx->rt, 0)) {
-        JS_ThrowStackOverflow(s->ctx);
-        return -1;
-    }
-
-    tag = JS_VALUE_GET_NORM_TAG(obj);
-    switch(tag) {
-    case JS_TAG_NULL:
-        bc_put_u8(s, BC_TAG_NULL);
