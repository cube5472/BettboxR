-static int call_setter(JSContext *ctx, JSObject *setter,
-                       JSValueConst this_obj, JSValue val, int flags)
-{
-    JSValue ret, func;
-    if (likely(setter)) {
-        func = JS_MKPTR(JS_TAG_OBJECT, setter);
