-    if (module_name == JS_ATOM_NULL)
-        return JS_ATOM_NULL;
-    if (next_token(s)) {
-        JS_FreeAtom(s->ctx, module_name);
-        return JS_ATOM_NULL;
-    }
-    return module_name;
