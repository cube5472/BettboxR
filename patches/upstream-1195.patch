+
+Proxy _proxy(String name, {String? now}) =>
+    Proxy(name: name, type: 'Shadowsocks', now: now);
+
+void main() {
+  setUp(() {
+    globalState.appState = AppState(
+      brightness: Brightness.light,
+      version: 0,
+      viewSize: Size.zero,
+      requests: FixedList(maxLength),
+      logs: FixedList(maxLogLength),
