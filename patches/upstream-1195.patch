-      if (delta is TextEditingDeltaNonTextUpdate) {
-        final isEcho =
-            _lastSentSelection != null && delta.selection == _lastSentSelection;
-        if (!isEcho) {
-          if (isBufferActive) {
-            _flushBuffer();
-          }
-          final isImeSelectAll = _imeProjectionText.isNotEmpty &&
-              delta.selection.start == 0 &&
