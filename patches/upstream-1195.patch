-            bf_t a_s, *a, b_s, *b;
-            if (tag1 != tag2) {
-                res = FALSE;
-                break;
-            }
-            a = JS_ToBigFloat(ctx, &a_s, op1);
-            b = JS_ToBigFloat(ctx, &b_s, op2);
