+      verticalOffset.applyContentDimensions(
+        0.0,
+        math.max(0.0, child.size.height - viewportDimension.height),
+      );
+      horizontalOffset.applyContentDimensions(
+        0.0,
+        math.max(0.0, child.size.width - viewportDimension.width),
+      );
+    }
