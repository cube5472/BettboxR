-    default:
-        return -1;
-    }
-    if (tok == TOK_VAR || tok == TOK_LET || tok == TOK_CONST) {
-        if (next_token(s))
-            return -1;
-
-        if (!(s->token.val == TOK_IDENT && !s->token.u.ident.is_reserved)) {
-            if (s->token.val == '[' || s->token.val == '{') {
-                if (js_parse_destructuring_element(s, tok, 0, TRUE, -1, FALSE) < 0)
