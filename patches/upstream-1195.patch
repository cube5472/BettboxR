+      var low = 0, high = highlights.length;
+      while (low < high) {
+        final mid = (low + high) >> 1;
+        if (highlights[mid].end <= shownStart) {
+          low = mid + 1;
+        } else {
+          high = mid;
+        }
+      }
+      for (var i = low; i < highlights.length; i++) {
+        final highlight = highlights[i];
