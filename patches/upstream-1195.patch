+++ b/plugins/code_forge/rust/src/api/script.rs
@@ -0,0 +1,101 @@
+use crate::script::{self, ErrorKind, Failure, LogLine, EVALUATE_LIMITS};
+use flutter_rust_bridge::frb;
+
+pub struct ScriptLog {
+    pub level: String,
+    pub text: String,
+}
+
+pub enum ScriptErrorKind {
+    Syntax,
+    Runtime,
+    Timeout,
+    OutOfMemory,
+    Cancelled,
+    InvalidInput,
+    InvalidOutput,
+}
+
+pub struct ScriptError {
+    pub kind: ScriptErrorKind,
+    pub message: String,
+    pub stack: Option<String>,
+    pub logs: Vec<ScriptLog>,
+}
+
+pub struct ScriptOutput {
+    pub logs: Vec<ScriptLog>,
+    pub elapsed_ms: u32,
+}
+
+fn to_logs(lines: Vec<LogLine>) -> Vec<ScriptLog> {
+    lines
+        .into_iter()
+        .map(|line| ScriptLog {
+            level: line.level,
+            text: line.text,
+        })
+        .collect()
+}
+
+impl From<Failure> for ScriptError {
+    fn from(failure: Failure) -> Self {
+        Self {
+            kind: match failure.kind {
+                ErrorKind::Syntax => ScriptErrorKind::Syntax,
+                ErrorKind::Runtime => ScriptErrorKind::Runtime,
+                ErrorKind::Timeout => ScriptErrorKind::Timeout,
+                ErrorKind::OutOfMemory => ScriptErrorKind::OutOfMemory,
+                ErrorKind::Cancelled => ScriptErrorKind::Cancelled,
+                ErrorKind::InvalidInput => ScriptErrorKind::InvalidInput,
+                ErrorKind::InvalidOutput => ScriptErrorKind::InvalidOutput,
+            },
+            message: failure.message,
+            stack: failure.stack,
+            logs: to_logs(failure.logs),
+        }
+    }
+}
+
+fn io_failure(error: std::io::Error) -> ScriptError {
+    ScriptError {
+        kind: ScriptErrorKind::InvalidInput,
+        message: error.to_string(),
+        stack: None,
+        logs: Vec::new(),
+    }
+}
+
+#[frb]
+pub fn evaluate_script_file(
+    script: String,
+    input_path: String,
+    output_path: String,
+    custom_options: Option<String>,
+    token: u32,
+) -> Result<ScriptOutput, ScriptError> {
+    let started = std::time::Instant::now();
+    let config = std::fs::read(&input_path).map_err(io_failure)?;
+    let evaluation = script::evaluate(
+        &script,
+        &config,
+        custom_options.as_deref(),
+        EVALUATE_LIMITS,
+        token,
+    )?;
+    std::fs::write(&output_path, evaluation.config).map_err(io_failure)?;
+    Ok(ScriptOutput {
+        logs: to_logs(evaluation.logs),
+        elapsed_ms: started.elapsed().as_millis().min(u32::MAX as u128) as u32,
+    })
+}
+
+#[frb]
+pub fn cancel_script(token: u32) {
+    script::cancel(token);
+}
+
+#[frb]
+pub fn extract_script_options(script: String) -> Result<String, ScriptError> {
+    script::extract_options(&script).map_err(ScriptError::from)
+}
diff --git a/plugins/code_forge/rust/src/editor/buffer.rs b/plugins/code_forge/rust/src/editor/buffer.rs
new file mode 100644
index 0000000..26a3799
--- /dev/null
+++ b/plugins/code_forge/rust/src/editor/buffer.rs
@@ -0,0 +1,105 @@
+use ropey::Rope;
+use std::sync::{RwLock, RwLockReadGuard};
+
+pub struct Buffer {
+    rope: RwLock<Rope>,
+}
+
+impl Buffer {
+    pub fn new(initial_text: &str) -> Self {
+        Self {
+            rope: RwLock::new(Rope::from_str(initial_text)),
+        }
+    }
+
+    pub fn rope(&self) -> RwLockReadGuard<'_, Rope> {
+        self.rope.read().unwrap()
+    }
+
+    /// Shares the tree instead of copying it, so a long scan need not hold the lock.
+    pub fn snapshot(&self) -> Rope {
+        self.rope().clone()
+    }
+
+    pub fn len_chars(&self) -> usize {
+        self.rope().len_chars()
+    }
+
+    pub fn text(&self) -> String {
+        self.rope().to_string()
+    }
+
+    pub fn insert(&self, char_idx: usize, text: &str) {
+        let mut rope = self.rope.write().unwrap();
+        let idx = char_idx.min(rope.len_chars());
+        rope.insert(idx, text);
+    }
+
+    pub fn remove(&self, start: usize, end: usize) {
+        let mut rope = self.rope.write().unwrap();
+        let len = rope.len_chars();
+        let start = start.min(len);
+        rope.remove(start..end.clamp(start, len));
+    }
+
+    pub fn slice(&self, start: usize, end: usize) -> String {
+        let rope = self.rope();
+        let valid_start = start.min(rope.len_chars());
+        let valid_end = end.max(valid_start).min(rope.len_chars());
+        rope.slice(valid_start..valid_end).to_string()
+    }
+
+    pub fn char_to_line(&self, char_idx: usize) -> usize {
+        let rope = self.rope();
+        rope.char_to_line(char_idx.min(rope.len_chars()))
+    }
+
+    pub fn line_to_char(&self, line_idx: usize) -> usize {
+        let rope = self.rope();
+        rope.line_to_char(line_idx.min(rope.len_lines().saturating_sub(1)))
+    }
+
+    pub fn line(&self, line_idx: usize) -> String {
+        let rope = self.rope();
+        let valid_idx = line_idx.min(rope.len_lines().saturating_sub(1));
+        line_without_break(&rope, valid_idx)
+    }
+
+    pub fn len_lines(&self) -> usize {
+        self.rope().len_lines()
+    }
+
+    pub fn lines(&self, start_line: usize, end_line: usize) -> Vec<String> {
+        let rope = self.rope();
+        let total = rope.len_lines();
+        let start = start_line.min(total);
+        let end = end_line.min(total).max(start);
+        (start..end)
+            .map(|line_idx| line_without_break(&rope, line_idx))
+            .collect()
+    }
+}
+
+pub(super) fn line_without_break(rope: &Rope, line_idx: usize) -> String {
+    let mut line = rope.line(line_idx).to_string();
+    if line.ends_with("\r\n") {
+        line.truncate(line.len() - 2);
+    } else if line.ends_with('\n') {
+        line.truncate(line.len() - 1);
+    }
+    line
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn edits_out_of_bounds_are_clamped() {
+        let buffer = Buffer::new("abc");
+        buffer.insert(10, "d");
+        buffer.remove(2, 10);
+        buffer.remove(3, 1);
+        assert_eq!(buffer.text(), "ab");
+    }
+}
diff --git a/plugins/code_forge/rust/src/editor/folds.rs b/plugins/code_forge/rust/src/editor/folds.rs
new file mode 100644
index 0000000..f64e3c3
--- /dev/null
+++ b/plugins/code_forge/rust/src/editor/folds.rs
@@ -0,0 +1,214 @@
+use crate::api::editor::RustFoldRange;
+use ropey::{Rope, RopeSlice};
+use std::collections::HashMap;
+
+// Mirrors the renderer's per-line fallback for small documents: a bracket
+// fold, or for a line ending in ':' the run of deeper-indented lines after
+// it, the smaller of the two when a line has both.
+pub fn compute_all(rope: &Rope, tab_size: usize) -> Vec<RustFoldRange> {
+    let mut ends: HashMap<i32, i32> = HashMap::new();
+    for fold in bracket_folds(rope) {
+        ends.entry(fold.start_line).or_insert(fold.end_line);
+    }
+    for fold in indent_folds(rope, tab_size) {
+        ends.entry(fold.start_line)
+            .and_modify(|end| *end = (*end).min(fold.end_line))
+            .or_insert(fold.end_line);
+    }
+    let mut folds: Vec<RustFoldRange> = ends
+        .into_iter()
+        .map(|(start_line, end_line)| RustFoldRange {
+            start_line,
+            end_line,
+        })
+        .collect();
+    folds.sort_by_key(|fold| fold.start_line);
+    folds
+}
+
+fn bracket_folds(rope: &Rope) -> Vec<RustFoldRange> {
+    let mut folds = Vec::new();
+    let mut open: [Vec<i32>; 3] = Default::default();
+    let mut line_idx: i32 = 0;
+
+    for ch in rope.chars() {
+        let (kind, opens) = match ch {
+            '\n' => {
+                line_idx += 1;
+                continue;
+            }
+            '{' => (0, true),
+            '}' => (0, false),
+            '[' => (1, true),
+            ']' => (1, false),
+            '(' => (2, true),
+            ')' => (2, false),
+            _ => continue,
+        };
+        if opens {
+            open[kind].push(line_idx);
+        } else if let Some(start_line) = open[kind].pop() {
+            if start_line < line_idx {
+                folds.push(RustFoldRange {
+                    start_line,
+                    end_line: line_idx,
+                });
+            }
+        }
+    }
+    folds
+}
+
+fn indent_folds(rope: &Rope, tab_size: usize) -> Vec<RustFoldRange> {
+    let mut folds = Vec::new();
+    let mut open: Vec<(usize, usize)> = Vec::new();
+    let mut last_content = 0;
+    for (line_idx, line) in rope.lines().enumerate() {
+        let Some((indent, ends_with_colon)) = scan_line(line, tab_size) else {
+            continue;
+        };
+        while let Some(&(start, start_indent)) = open.last() {
+            if indent > start_indent {
+                break;
+            }
+            open.pop();
+            close(start, last_content, &mut folds);
+        }
+        if ends_with_colon {
+            open.push((line_idx, indent));
+        }
+        last_content = line_idx;
+    }
+    for (start, _) in open {
+        close(start, last_content, &mut folds);
+    }
+    folds
+}
+
+fn close(start: usize, end: usize, folds: &mut Vec<RustFoldRange>) {
+    if end > start {
+        folds.push(RustFoldRange {
+            start_line: start as i32,
+            end_line: end as i32,
+        });
+    }
+}
+
+// The leading indent in columns and whether the line ends in ':', or None
+// for a blank line.
+fn scan_line(line: RopeSlice, tab_size: usize) -> Option<(usize, bool)> {
+    let mut indent = 0;
+    let mut in_indent = true;
+    let mut last = None;
+    for ch in line.chars() {
+        if in_indent {
+            match ch {
+                ' ' => indent += 1,
+                '\t' if tab_size > 0 => indent += tab_size - indent % tab_size,
+                '\t' => indent += 1,
+                _ => in_indent = false,
+            }
+        }
+        // The per-line pass in Dart trims U+FEFF as whitespace.
+        if !ch.is_whitespace() && ch != '\u{feff}' {
+            last = Some(ch);
+        }
+    }
+    last.map(|ch| (indent, ch == ':'))
+}
+
+pub fn find_matching_bracket(rope: &Rope, target_offset: usize) -> Option<usize> {
+    let len = rope.len_chars();
+    if target_offset >= len {
+        return None;
+    }
+
+    let start_ch: char = rope.char(target_offset);
+
+    let (matcher, search_forward) = match start_ch {
+        '{' => ('}', true),
+        '[' => (']', true),
+        '(' => (')', true),
+        '}' => ('{', false),
+        ']' => ('[', false),
+        ')' => ('(', false),
+        _ => return None,
+    };
+
+    let mut depth = 1;
+
+    if search_forward {
+        for (i, ch) in rope.chars_at(target_offset + 1).enumerate() {
+            let idx = target_offset + 1 + i;
+            if idx >= len {
+                break;
+            }
+            if ch == start_ch {
+                depth += 1;
+            } else if ch == matcher {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(idx);
+                }
+            }
+        }
+    } else {
+        let mut idx = target_offset;
+        while idx > 0 {
+            idx -= 1;
+            let ch = rope.char(idx);
+            if ch == start_ch {
+                depth += 1;
+            } else if ch == matcher {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(idx);
+                }
+            }
+        }
+    }
+
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn folds(text: &str) -> Vec<(i32, i32)> {
+        compute_all(&Rope::from_str(text), 2)
+            .into_iter()
+            .map(|fold| (fold.start_line, fold.end_line))
+            .collect()
+    }
+
+    #[test]
+    fn a_key_folds_over_its_deeper_lines_across_blank_ones() {
+        let text = "proxies:\n  - name: a\n    ws-opts:\n      path: /\n\n  - name: b\nrules:\n  - MATCH,DIRECT\n\n";
+        assert_eq!(folds(text), [(0, 5), (2, 3), (6, 7)]);
+    }
+
+    #[test]
+    fn a_key_without_deeper_lines_does_not_fold() {
+        assert_eq!(folds("a:\nb: 1\nc:\n"), []);
+    }
+
+    #[test]
+    fn a_byte_order_mark_counts_as_blank() {
+        assert_eq!(folds("a:\u{feff}\n  b\nc\n"), [(0, 1)]);
+        assert_eq!(folds("a:\n  b\n\u{feff}\n  c\nd\n"), [(0, 3)]);
+    }
+
+    #[test]
+    fn a_line_with_both_keeps_the_smaller_fold() {
+        assert_eq!(folds("f(a,\n  b:\n    c\n  d)\n"), [(0, 3), (1, 2)]);
+        assert_eq!(folds("x: {\n  a: 1\n}\n"), [(0, 2)]);
+    }
+
+    #[test]
+    fn a_stray_bracket_leaves_the_other_kinds_their_folds() {
+        assert_eq!(folds("a {\n  b (\n}\n"), [(0, 2)]);
+        assert_eq!(folds("a [\n  b )\n]\n"), [(0, 2)]);
+        assert_eq!(folds("f(x, [\n  y)\n]\n"), [(0, 1)]);
+    }
+}
diff --git a/plugins/code_forge/rust/src/editor/guides.rs b/plugins/code_forge/rust/src/editor/guides.rs
new file mode 100644
index 0000000..6acf325
--- /dev/null
+++ b/plugins/code_forge/rust/src/editor/guides.rs
@@ -0,0 +1,162 @@
+use crate::api::editor::GuideBlock;
+use ropey::{Rope, RopeSlice};
+
+const SCAN_BACK_LIMIT: usize = 500;
+
+pub fn compute_viewport(
+    rope: &Rope,
+    first_visible: usize,
+    last_visible: usize,
+    tab_size: usize,
+) -> Vec<GuideBlock> {
+    let total_lines = rope.len_lines();
+
+    if total_lines == 0 {
+        return Vec::new();
+    }
+
+    let first = first_visible.min(total_lines.saturating_sub(1));
+    let last = last_visible.min(total_lines.saturating_sub(1));
+    let scan_start = first.saturating_sub(SCAN_BACK_LIMIT);
+    // Nothing below the viewport is drawn, so a block still open at the
+    // horizon is reported as ending there instead of scanning the document.
+    let horizon = (last + 2).min(total_lines);
+
+    let mut blocks: Vec<GuideBlock> = Vec::new();
+
+    for line_idx in scan_start..=last {
+        let line_slice = rope.line(line_idx);
+        let mut line_len = content_len(&line_slice);
+
+        while line_len > 0 && line_slice.char(line_len - 1).is_whitespace() {
+            line_len -= 1;
+        }
+
+        if line_len == 0 {
+            continue;
+        }
+
+        let last_char = line_slice.char(line_len - 1);
+        if !matches!(last_char, '{' | '(' | '[' | ':') {
+            continue;
+        }
+
+        let leading_cols = leading_columns(&line_slice, line_len, tab_size);
+        let indent_level = leading_cols.checked_div(tab_size).unwrap_or(0);
+
+        let mut end_line: usize = line_idx + 1;
+
+        if matches!(last_char, '{' | '(' | '[') {
+            let bracket_pos = rope.line_to_char(line_idx) + line_len - 1;
+            let limit = rope.line_to_char(horizon);
+            if let Some(match_pos) = find_matching_bracket_forward(rope, bracket_pos, limit) {
+                end_line = rope.char_to_line(match_pos) + 1;
+            }
+        }
+
+        if end_line <= line_idx + 1 {
+            let mut scan = line_idx + 1;
+            let mut last_valid = line_idx;
+            while scan < horizon {
+                let line_slice = rope.line(scan);
+                let nl_len = content_len(&line_slice);
+                if is_blank(&line_slice, nl_len) {
+                    scan += 1;
+                    continue;
+                }
+                if leading_columns(&line_slice, nl_len, tab_size) <= leading_cols {
+                    break;
+                }
+                last_valid = scan;
+                scan += 1;
+            }
+            end_line = if scan == horizon && horizon < total_lines {
+                horizon
+            } else {
+                last_valid + 1
+            };
+        }
+
+        if end_line <= line_idx + 1 {
+            continue;
+        }
+
+        let would_pass = ((line_idx + 1)..(end_line.saturating_sub(1).min(horizon))).any(|check| {
+            let cl_slice = rope.line(check);
+            let cl_len = content_len(&cl_slice);
+            !is_blank(&cl_slice, cl_len)
+                && leading_columns(&cl_slice, cl_len, tab_size) <= leading_cols
+        });
+
+        if would_pass {
+            continue;
+        }
+
+        blocks.push(GuideBlock {
+            start_line: line_idx as i32,
+            end_line: end_line as i32,
+            indent_level: indent_level as i32,
+            leading_spaces: leading_cols as i32,
+        });
+    }
+
+    blocks
+}
+
+fn content_len(line: &RopeSlice) -> usize {
+    let mut len = line.len_chars();
+    if len >= 2 && line.char(len - 1) == '\n' && line.char(len - 2) == '\r' {
+        len -= 2;
+    }
+    if len >= 1 && line.char(len - 1) == '\n' {
+        len -= 1;
+    }
+    len
+}
+
+fn is_blank(line: &RopeSlice, len: usize) -> bool {
+    (0..len).all(|i| line.char(i).is_whitespace())
+}
+
+fn leading_columns(line: &RopeSlice, len: usize, tab_size: usize) -> usize {
+    let mut cols: usize = 0;
+    for i in 0..len {
+        match line.char(i) {
+            ' ' => cols += 1,
+            '\t' if tab_size > 0 => cols += tab_size - cols % tab_size,
+            '\t' => cols += 1,
+            _ => break,
+        }
+    }
+    cols
+}
+
+fn find_matching_bracket_forward(
+    rope: &Rope,
+    open_offset: usize,
+    limit_char: usize,
+) -> Option<usize> {
+    let open = rope.char(open_offset);
+    let close = match open {
+        '{' => '}',
+        '[' => ']',
+        '(' => ')',
+        _ => return None,
+    };
+    let mut depth = 1;
+    for (i, ch) in rope.chars_at(open_offset + 1).enumerate() {
+        let idx = open_offset + 1 + i;
+        if idx >= limit_char {
+            break;
+        }
+        if ch == open {
+            depth += 1;
+        } else if ch == close {
+            depth -= 1;
+            if depth == 0 {
+                return Some(idx);
+            }
+        }
+    }
+    None
+}
diff --git a/plugins/code_forge/rust/src/editor/highlight/engine.rs b/plugins/code_forge/rust/src/editor/highlight/engine.rs
new file mode 100644
index 0000000..1ccac9b
--- /dev/null
+++ b/plugins/code_forge/rust/src/editor/highlight/engine.rs
@@ -0,0 +1,984 @@
+//! The matching loop of highlight.js as re_highlight 0.0.3 runs it, over a
+//! grammar that package compiled and `highlight_grammar_test.dart` exported.
+//! Anything the loop cannot do as that package does gives `None`, and the
+//! caller falls back to the package for that line.
+
+use fancy_regex::Regex;
+use serde_json::Value;
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::rc::Rc;
+
+const SPACE: &str = r"\t\n\x0B\x0C\r \x{a0}\x{1680}\x{2000}-\x{200a}\x{2028}\x{2029}\x{202f}\x{205f}\x{3000}\x{feff}";
+const WORD: &str = "A-Za-z0-9_";
+const TERMINATOR: &str = r"\n\r\x{2028}\x{2029}";
+
+/// A JavaScript pattern without the `u` flag as a pattern of this crate's
+/// engine, where `\w`, `\d`, `\s` and `\b` would otherwise be Unicode-aware.
+fn translate(source: &str) -> Option<String> {
+    let chars: Vec<char> = source.chars().collect();
+    let mut out = String::with_capacity(source.len() * 2);
+    let mut in_class = false;
+    let mut at = 0;
+    while at < chars.len() {
+        let ch = chars[at];
+        at += 1;
+        if ch == '\\' {
+            let escaped = *chars.get(at)?;
+            at += 1;
+            match (escaped, in_class) {
+                ('d', false) => out.push_str("[0-9]"),
+                ('d', true) => out.push_str("0-9"),
+                ('w', false) => out.push_str(&format!("[{WORD}]")),
+                ('w', true) => out.push_str(WORD),
+                ('s', false) => out.push_str(&format!("[{SPACE}]")),
+                ('s', true) => out.push_str(SPACE),
+                ('S', false) => out.push_str(&format!("[^{SPACE}]")),
+                ('W', false) => out.push_str(&format!("[^{WORD}]")),
+                ('D', false) => out.push_str("[^0-9]"),
+                ('b', false) => out.push_str(&format!(
+                    "(?:(?<=[{WORD}])(?![{WORD}])|(?<![{WORD}])(?=[{WORD}]))"
+                )),
+                ('B', false) => out.push_str(&format!(
+                    "(?:(?<=[{WORD}])(?=[{WORD}])|(?<![{WORD}])(?![{WORD}]))"
+                )),
+                ('S', true) => out.push_str(&format!("[^{SPACE}]")),
+                ('W', true) => out.push_str(&format!("[^{WORD}]")),
+                ('D', true) => out.push_str("[^0-9]"),
+                ('b' | 'B', true) => return None,
+                _ => {
+                    out.push('\\');
+                    out.push(escaped);
+                }
+            }
+        } else if in_class {
+            match ch {
+                ']' => {
+                    in_class = false;
+                    out.push(']');
+                }
+                '[' | '&' | '~' => {
+                    out.push('\\');
+                    out.push(ch);
+                }
+                _ => out.push(ch),
+            }
+        } else {
+            match ch {
+                '[' => {
+                    in_class = true;
+                    out.push('[');
+                    if chars.get(at) == Some(&'^') {
+                        out.push('^');
+                        at += 1;
+                    }
+                }
+                '.' => out.push_str(&format!("[^{TERMINATOR}]")),
+                '^' => out.push_str(&format!(r"(?:\A|(?<=[{TERMINATOR}]))")),
+                '$' => out.push_str(&format!(r"(?=[{TERMINATOR}]|\z)")),
+                _ => out.push(ch),
+            }
+        }
+    }
+    Some(out)
+}
+
+fn count_groups(pattern: &str) -> usize {
+    let chars: Vec<char> = pattern.chars().collect();
+    let mut count = 0;
+    let mut in_class = false;
+    let mut at = 0;
+    while at < chars.len() {
+        match chars[at] {
+            '\\' => at += 1,
+            '[' if !in_class => in_class = true,
+            ']' if in_class => in_class = false,
+            '(' if !in_class && chars.get(at + 1) != Some(&'?') => count += 1,
+            _ => {}
+        }
+        at += 1;
+    }
+    count
+}
+
+/// The characters a pattern's match can start with: the ASCII ones, whether
+/// any other, and whether it can match nothing at all. Wider than the truth
+/// wherever the pattern is not worth following, never narrower.
+#[derive(Clone)]
+struct First {
+    ascii: [bool; 128],
+    other: bool,
+    empty: bool,
+}
+
+impl First {
+    fn none() -> Self {
+        Self {
+            ascii: [false; 128],
+            other: false,
+            empty: false,
+        }
+    }
+
+    fn any() -> Self {
+        Self {
+            ascii: [true; 128],
+            other: true,
+            empty: true,
+        }
+    }
+
+    fn of(accepts: impl Fn(char) -> bool, other: bool) -> Self {
+        let mut first = Self::none();
+        for code in 0..128u8 {
+            first.ascii[code as usize] = accepts(code as char);
+        }
+        first.other = other;
+        first
+    }
+
+    fn add(&mut self, more: &First) {
+        for (mine, theirs) in self.ascii.iter_mut().zip(more.ascii) {
+            *mine |= theirs;
+        }
+        self.other |= more.other;
+    }
+
+    fn inverted(&self) -> Self {
+        let mut first = Self::none();
+        for (mine, theirs) in first.ascii.iter_mut().zip(self.ascii) {
+            *mine = !theirs;
+        }
+        first.other = true;
+        first
+    }
+
+    fn accepts(&self, key: usize) -> bool {
+        self.empty
+            || match key {
+                0..=127 => self.ascii[key],
+                128 => self.other,
+                _ => false,
+            }
+    }
+}
+
+struct FirstParser {
+    chars: Vec<char>,
+    at: usize,
+}
+
+impl FirstParser {
+    fn escape(&mut self) -> Option<First> {
+        let escaped = *self.chars.get(self.at)?;
+        self.at += 1;
+        let ascii_space = |ch: char| matches!(ch, '\t' | '\n' | '\u{b}' | '\u{c}' | '\r' | ' ');
+        Some(match escaped {
+            'd' => First::of(|ch| ch.is_ascii_digit(), false),
+            'w' => First::of(super::is_word, false),
+            's' => First::of(ascii_space, true),
+            'D' => First::of(|ch| ch.is_ascii_digit(), false).inverted(),
+            'W' => First::of(super::is_word, false).inverted(),
+            'S' => First::of(ascii_space, true).inverted(),
+            't' => First::of(|ch| ch == '\t', false),
+            'n' => First::of(|ch| ch == '\n', false),
+            'r' => First::of(|ch| ch == '\r', false),
+            _ if escaped.is_ascii_alphanumeric() => return None,
+            _ => First::of(|ch| ch == escaped, !escaped.is_ascii()),
+        })
+    }
+
+    fn class(&mut self) -> Option<First> {
+        let negated = self.chars.get(self.at) == Some(&'^');
+        if negated {
+            self.at += 1;
+        }
+        let mut first = First::none();
+        loop {
+            let ch = *self.chars.get(self.at)?;
+            self.at += 1;
+            if ch == ']' {
+                break;
+            }
+            let (item, single) = if ch == '\\' {
+                let escaped = *self.chars.get(self.at)?;
+                (self.escape()?, (!escaped.is_ascii_alphanumeric()).then_some(escaped))
+            } else {
+                (First::of(|other| other == ch, !ch.is_ascii()), Some(ch))
+            };
+            let ranged = self.chars.get(self.at) == Some(&'-')
+                && self.chars.get(self.at + 1).is_some_and(|&next| next != ']');
+            if !ranged {
+                first.add(&item);
+                continue;
+            }
+            let low = single?;
+            self.at += 1;
+            let mut high = *self.chars.get(self.at)?;
+            self.at += 1;
+            if high == '\\' {
+                high = *self.chars.get(self.at)?;
+                self.at += 1;
+                if high.is_ascii_alphanumeric() {
+                    return None;
+                }
+            }
+            first.add(&First::of(|other| low <= other && other <= high, !high.is_ascii()));
+        }
+        Some(if negated { first.inverted() } else { first })
+    }
+
+    /// An atom with its quantifier: what it starts with and whether it can
+    /// be empty.
+    fn atom(&mut self) -> Option<(First, bool)> {
+        let ch = *self.chars.get(self.at)?;
+        self.at += 1;
+        let (first, mut empty) = match ch {
+            '(' => {
+                let ahead = self.chars.get(self.at) == Some(&'?');
+                let kind = self.chars.get(self.at + 1).copied();
+                if ahead {
+                    if !matches!(kind, Some(':' | '=' | '!')) {
+                        return None;
+                    }
+                    self.at += 2;
+                }
+                let inner = self.alternation()?;
+                if self.chars.get(self.at) != Some(&')') {
+                    return None;
+                }
+                self.at += 1;
+                if ahead && kind != Some(':') {
+                    (First::none(), true)
+                } else {
+                    let empty = inner.empty;
+                    (inner, empty)
+                }
+            }
+            '[' => (self.class()?, false),
+            '\\' => match self.chars.get(self.at) {
+                Some('b' | 'B') => {
+                    self.at += 1;
+                    (First::none(), true)
+                }
+                _ => (self.escape()?, false),
+            },
+            '.' => (First::of(|other| !super::is_line_terminator(other), true), false),
+            '^' | '$' => (First::none(), true),
+            '*' | '+' | '?' | '{' | ')' | '|' => return None,
+            _ => (First::of(|other| other == ch, !ch.is_ascii()), false),
+        };
+        match self.chars.get(self.at) {
+            Some('*' | '?') => {
+                self.at += 1;
+                empty = true;
+            }
+            Some('+') => self.at += 1,
+            Some('{') => {
+                let close = self.chars[self.at..].iter().position(|&ch| ch == '}')?;
+                let bounds: String = self.chars[self.at + 1..self.at + close].iter().collect();
+                let least = bounds.split(',').next()?;
+                if least.is_empty() || least.parse::<u32>().ok()? == 0 {
+                    empty = true;
+                }
+                self.at += close + 1;
+            }
+            _ => {}
+        }
+        if self.chars.get(self.at) == Some(&'?') {
+            self.at += 1;
+        }
+        Some((first, empty))
+    }
+
+    fn alternation(&mut self) -> Option<First> {
+        let mut first = First::none();
+        loop {
+            let mut open = true;
+            while !matches!(self.chars.get(self.at), None | Some(')' | '|')) {
+                let (atom, empty) = self.atom()?;
+                if open {
+                    first.add(&atom);
+                    open = empty;
+                }
+            }
+            first.empty |= open;
+            if self.chars.get(self.at) != Some(&'|') {
+                return Some(first);
+            }
+            self.at += 1;
+        }
+    }
+}
+
+fn first_of(source: &str) -> First {
+    let mut parser = FirstParser {
+        chars: source.chars().collect(),
+        at: 0,
+    };
+    match parser.alternation() {
+        Some(first) if parser.at == parser.chars.len() => first,
+        _ => First::any(),
+    }
+}
+
+fn is_js_space(ch: char) -> bool {
+    super::is_space(ch)
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Kind {
+    Begin,
+    End,
+    Illegal,
+}
+
+struct Rule {
+    pattern: String,
+    first: First,
+    groups: usize,
+    kind: Kind,
+    mode: Option<usize>,
+}
+
+struct Scope {
+    wrap: Option<u32>,
+    multi: bool,
+    emit: HashMap<usize, bool>,
+    positions: HashMap<usize, Option<u32>>,
+}
+
+#[derive(Clone, Copy)]
+enum Callback {
+    Jsx,
+    Shebang,
+}
+
+/// Some of a mode's rules as one pattern, anchored where a search starts.
+/// An empty last alternative makes it match there whatever the rules do, as
+/// a search that fails goes on to try every later start.
+struct Multi {
+    /// For a search from the start of the text.
+    head: Regex,
+    /// For a search from one character into the text it is given, so that
+    /// what looks behind sees the character before.
+    tail: Regex,
+    /// The outer group of each rule and its index among the mode's rules.
+    rules: Vec<(usize, usize)>,
+}
+
+const END_OF_TEXT: usize = 129;
+
+struct Mode {
+    scope: Option<u32>,
+    has_scope: bool,
+    begin_scope: Option<Scope>,
+    end_scope: Option<Scope>,
+    keywords: Option<HashMap<String, Option<u32>>>,
+    keyword_pattern: Option<Regex>,
+    end: Option<Regex>,
+    skip: Option<bool>,
+    exclude_begin: bool,
+    exclude_end: bool,
+    return_begin: bool,
+    return_end: bool,
+    ends_with_parent: bool,
+    ends_parent: bool,
+    sub_language: bool,
+    before_begin: bool,
+    on_begin: Option<Callback>,
+    starts: Option<usize>,
+    count: usize,
+    rules: Vec<Rule>,
+    /// By the rules they hold.
+    matchers: RefCell<HashMap<Vec<usize>, Rc<Multi>>>,
+    /// By the first rule considered and the character searched from.
+    candidates: RefCell<HashMap<(usize, usize), Option<Rc<Multi>>>>,
+    regex_index: Cell<usize>,
+}
+
+pub struct Grammar {
+    modes: Vec<Mode>,
+    scopes: Vec<String>,
+}
+
+struct Found {
+    start: usize,
+    end: usize,
+    groups: Vec<Option<(usize, usize)>>,
+    rule: usize,
+    position: usize,
+}
+
+impl Grammar {
+    pub fn parse(json: &str) -> Option<Self> {
+        let root: Value = serde_json::from_str(json).ok()?;
+        if root["caseInsensitive"].as_bool()? || root["unicodeRegex"].as_bool()? {
+            return None;
+        }
+        let aliases = root["aliases"].as_object()?;
+        let mut scopes: Vec<String> = Vec::new();
+        let mut intern = |name: &str| -> u32 {
+            let name = aliases.get(name).and_then(Value::as_str).unwrap_or(name);
+            match scopes.iter().position(|known| known == name) {
+                Some(index) => index as u32,
+                None => {
+                    scopes.push(name.to_string());
+                    scopes.len() as u32 - 1
+                }
+            }
+        };
+        let mut modes = Vec::new();
+        for mode in root["modes"].as_array()? {
+            let mut scope_of = |value: &Value| -> Option<Option<Scope>> {
+                if value.is_null() {
+                    return Some(None);
+                }
+                let mut emit = HashMap::new();
+                for (key, flag) in value["emit"].as_object()? {
+                    emit.insert(key.parse().ok()?, flag.as_bool()?);
+                }
+                let mut positions = HashMap::new();
+                for (key, name) in value["positions"].as_object()? {
+                    positions.insert(key.parse().ok()?, name.as_str().map(&mut intern));
+                }
+                Some(Some(Scope {
+                    wrap: value["wrap"]
+                        .as_str()
+                        .filter(|wrap| !wrap.is_empty())
+                        .map(&mut intern),
+                    multi: value["multi"].as_bool()?,
+                    emit,
+                    positions,
+                }))
+            };
+            let begin_scope = scope_of(&mode["beginScope"])?;
+            let end_scope = scope_of(&mode["endScope"])?;
+            let keywords = match mode["keywords"].as_object() {
+                Some(words) => Some(
+                    words
+                        .iter()
+                        .map(|(word, kind)| {
+                            let kind = kind.as_str()?;
+                            Some((
+                                word.clone(),
+                                (!kind.starts_with('_')).then(|| intern(kind)),
+                            ))
+                        })
+                        .collect::<Option<HashMap<_, _>>>()?,
+                ),
+                None => None,
+            };
+            let compile = |value: &Value, anchored: bool| -> Option<Option<Regex>> {
+                let Some(source) = value.as_str() else {
+                    return Some(None);
+                };
+                let pattern = translate(source)?;
+                let pattern = if anchored {
+                    format!(r"\A(?:({pattern})|())")
+                } else {
+                    pattern
+                };
+                Some(Some(Regex::new(&pattern).ok()?))
+            };
+            let mut rules = Vec::new();
+            for rule in mode["rules"].as_array()? {
+                let pattern = translate(rule[0].as_str()?)?;
+                rules.push(Rule {
+                    first: first_of(rule[0].as_str()?),
+                    groups: count_groups(&pattern),
+                    pattern,
+                    kind: match rule[1].as_str()? {
+                        "begin" => Kind::Begin,
+                        "end" => Kind::End,
+                        "illegal" => Kind::Illegal,
+                        _ => return None,
+                    },
+                    mode: rule[2].as_u64().map(|id| id as usize),
+                });
+            }
+            modes.push(Mode {
+                scope: mode["scope"].as_str().map(&mut intern),
+                has_scope: mode["hasScope"].as_bool()?,
+                begin_scope,
+                end_scope,
+                keywords,
+                keyword_pattern: compile(&mode["keywordPattern"], false)?,
+                end: compile(&mode["end"], true)?,
+                skip: mode["skip"].as_bool(),
+                exclude_begin: mode["excludeBegin"].as_bool()?,
+                exclude_end: mode["excludeEnd"].as_bool()?,
+                return_begin: mode["returnBegin"].as_bool()?,
+                return_end: mode["returnEnd"].as_bool()?,
+                ends_with_parent: mode["endsWithParent"].as_bool()?,
+                ends_parent: mode["endsParent"].as_bool()?,
+                sub_language: mode["subLanguage"].as_bool()?,
+                before_begin: mode["beforeBegin"].as_bool()?,
+                on_begin: match mode["onBegin"].as_str() {
+                    Some("jsx") => Some(Callback::Jsx),
+                    Some("shebang") => Some(Callback::Shebang),
+                    Some(_) => return None,
+                    None => None,
+                },
+                starts: mode["starts"].as_u64().map(|id| id as usize),
+                count: mode["count"].as_u64()? as usize,
+                rules,
+                matchers: RefCell::new(HashMap::new()),
+                candidates: RefCell::new(HashMap::new()),
+                regex_index: Cell::new(0),
+            });
+        }
+        Some(Self { modes, scopes })
+    }
+
+    pub fn scopes(&self) -> &[String] {
+        &self.scopes
+    }
+
+    /// The rules from `start_at` on that can match at a character of class
+    /// `key`, in their order; `None` inside when there are none.
+    fn matcher(&self, mode: usize, start_at: usize, key: usize) -> Option<Option<Rc<Multi>>> {
+        let mode = &self.modes[mode];
+        if let Some(known) = mode.candidates.borrow().get(&(start_at, key)) {
+            return Some(known.clone());
+        }
+        let indexes: Vec<usize> = (start_at..mode.rules.len())
+            .filter(|&index| mode.rules[index].first.accepts(key))
+            .collect();
+        let multi = if indexes.is_empty() {
+            None
+        } else if let Some(known) = mode.matchers.borrow().get(&indexes) {
+            Some(known.clone())
+        } else {
+            let mut pattern = String::new();
+            let mut rules = Vec::new();
+            let mut group = 1;
+            for &index in &indexes {
+                let rule = &mode.rules[index];
+                if !pattern.is_empty() {
+                    pattern.push('|');
+                }
+                pattern.push('(');
+                pattern.push_str(&rule.pattern);
+                pattern.push(')');
+                rules.push((group, index));
+                group += rule.groups + 1;
+            }
+            Some(Rc::new(Multi {
+                head: Regex::new(&format!(r"\A(?:{pattern}|())")).ok()?,
+                tail: Regex::new(&format!(r"\A(?s:.)(?:{pattern}|())")).ok()?,
+                rules,
+            }))
+        };
+        if let Some(multi) = &multi {
+            mode.matchers.borrow_mut().insert(indexes, multi.clone());
+        }
+        mode.candidates
+            .borrow_mut()
+            .insert((start_at, key), multi.clone());
+        Some(multi)
+    }
+
+    /// The first match at or after `from` of the rules from `start_at` on:
+    /// at each character the first rule that matches there, as the one
+    /// pattern re_highlight joins them into finds it.
+    fn exec_multi(&self, mode: usize, start_at: usize, text: &str, from: usize) -> Option<Option<Found>> {
+        let mut at = from;
+        let mut before = text[..from].chars().next_back().map_or(0, char::len_utf8);
+        loop {
+            let next = text[at..].chars().next();
+            let key = match next {
+                None => END_OF_TEXT,
+                Some(ch) if ch.is_ascii() => ch as usize,
+                Some(_) => 128,
+            };
+            if let Some(multi) = self.matcher(mode, start_at, key)? {
+                let base = at - before;
+                let regex = if at == 0 { &multi.head } else { &multi.tail };
+                if let Some(captures) = regex.captures(&text[base..]).ok()? {
+                    for &(group, rule) in &multi.rules {
+                        let Some(outer) = captures.get(group) else {
+                            continue;
+                        };
+                        let count = self.modes[mode].rules[rule].groups;
+                        return Some(Some(Found {
+                            start: base + outer.start(),
+                            end: base + outer.end(),
+                            groups: (group..=group + count)
+                                .map(|index| {
+                                    captures
+                                        .get(index)
+                                        .map(|found| (base + found.start(), base + found.end()))
+                                })
+                                .collect(),
+                            rule,
+                            position: rule - start_at,
+                        }));
+                    }
+                }
+            }
+            let Some(next) = next else {
+                return Some(None);
+            };
+            before = next.len_utf8();
+            at += before;
+        }
+    }
+
+    /// The next match of the mode's rules, resuming after an ignored one as
+    /// `_ResumableMultiRegex` does.
+    fn exec(&self, mode: usize, text: &str, from: usize) -> Option<Option<Found>> {
+        let state = &self.modes[mode].regex_index;
+        let mut found = self.exec_multi(mode, state.get(), text, from)?;
+        if state.get() != 0 && !found.as_ref().is_some_and(|found| found.start == from) {
+            let next = from + text[from..].chars().next()?.len_utf8();
+            found = self.exec_multi(mode, 0, text, next)?;
+        }
+        if let Some(found) = &found {
+            state.set(state.get() + found.position + 1);
+            if state.get() == self.modes[mode].count {
+                state.set(0);
+            }
+        }
+        Some(found)
+    }
+
+    pub fn highlight(&self, text: &str) -> Option<Vec<u32>> {
+        Run {
+            grammar: self,
+            text,
+            stack: vec![0],
+            buffer: String::new(),
+            nodes: vec![None],
+            runs: Vec::new(),
+            last: None,
+            resume: false,
+        }
+        .run()
+    }
+}
+
+struct Run<'a> {
+    grammar: &'a Grammar,
+    text: &'a str,
+    stack: Vec<usize>,
+    buffer: String,
+    nodes: Vec<Option<u32>>,
+    runs: Vec<(Option<u32>, u32)>,
+    last: Option<(Kind, usize)>,
+    resume: bool,
+}
+
+const NO_MATCH: usize = usize::MAX;
+
+impl Run<'_> {
+    fn top(&self) -> &Mode {
+        &self.grammar.modes[*self.stack.last().expect("mode stack")]
+    }
+
+    fn add_text(&mut self, text: &str) {
+        if text.is_empty() {
+            return;
+        }
+        let scope = *self.nodes.last().expect("node stack");
+        let units = text.encode_utf16().count() as u32;
+        match self.runs.last_mut() {
+            Some((last, length)) if *last == scope => *length += units,
+            _ => self.runs.push((scope, units)),
+        }
+    }
+
+    fn close_node(&mut self) {
+        if self.nodes.len() > 1 {
+            self.nodes.pop();
+        }
+    }
+
+    fn emit_keyword(&mut self, text: &str, scope: u32) {
+        if text.is_empty() {
+            return;
+        }
+        self.nodes.push(Some(scope));
+        self.add_text(text);
+        self.close_node();
+    }
+
+    fn process_keywords(&mut self) -> Option<()> {
+        let buffer = std::mem::take(&mut self.buffer);
+        let mode = *self.stack.last()?;
+        let mode = &self.grammar.modes[mode];
+        let (Some(keywords), Some(pattern)) = (&mode.keywords, &mode.keyword_pattern) else {
+            self.add_text(&buffer);
+            return Some(());
+        };
+        let mut pending = String::new();
+        let mut last = 0;
+        while let Some(found) = pattern.find_from_pos(&buffer, last).ok()? {
+            pending.push_str(&buffer[last..found.start()]);
+            match keywords.get(found.as_str()) {
+                Some(Some(scope)) => {
+                    self.add_text(&pending);
+                    pending.clear();
+                    self.emit_keyword(found.as_str(), *scope);
+                }
+                Some(None) => {
+                    self.add_text(&pending);
+                    pending.clear();
+                    pending.push_str(found.as_str());
+                }
+                None => pending.push_str(found.as_str()),
+            }
+            if found.end() == found.start() {
+                return None;
+            }
+            last = found.end();
+        }
+        pending.push_str(&buffer[last..]);
+        self.add_text(&pending);
+        Some(())
+    }
+
+    fn process_buffer(&mut self) -> Option<()> {
+        if self.top().sub_language {
+            let buffer = std::mem::take(&mut self.buffer);
+            self.add_text(&buffer);
+            return Some(());
+        }
+        self.process_keywords()
+    }
+
+    fn emit_multi(&mut self, scope: &Scope, found: &Found) -> Option<()> {
+        for index in 1..found.groups.len() {
+            if scope.emit.get(&index) != Some(&true) {
+                continue;
+            }
+            let (start, end) = found.groups[index]?;
+            let text = &self.text[start..end];
+            match scope.positions.get(&index).copied().flatten() {
+                Some(class) => self.emit_keyword(text, class),
+                None => {
+                    self.buffer = text.to_string();
+                    self.process_keywords()?;
+                }
+            }
+        }
+        Some(())
+    }
+
+    fn start_mode(&mut self, mode: usize, found: &Found) -> Option<()> {
+        let grammar = self.grammar;
+        let definition = &grammar.modes[mode];
+        if let Some(scope) = definition.scope {
+            self.nodes.push(Some(scope));
+        }
+        if let Some(scope) = &definition.begin_scope {
+            if let Some(wrap) = scope.wrap {
+                let buffer = std::mem::take(&mut self.buffer);
+                self.emit_keyword(&buffer, wrap);
+            } else if scope.multi {
+                self.emit_multi(scope, found)?;
+                self.buffer.clear();
+            }
+        }
+        self.stack.push(mode);
+        Some(())
+    }
+
+    fn end_of_mode(&self, depth: usize, rest: &str) -> Option<Option<usize>> {
+        let mode = &self.grammar.modes[self.stack[depth]];
+        if let Some(end) = &mode.end {
+            if end.captures(rest).ok()??.get(1).is_some() {
+                let mut depth = depth;
+                while self.grammar.modes[self.stack[depth]].ends_parent && depth > 0 {
+                    depth -= 1;
+                }
+                return Some(Some(depth));
+            }
+        }
+        if mode.ends_with_parent {
+            return self.end_of_mode(depth.checked_sub(1)?, rest);
+        }
+        Some(None)
+    }
+
+    fn ignored(&self, mode: &Mode, found: &Found) -> Option<bool> {
+        let text = self.text;
+        if mode.before_begin && text[..found.start].ends_with('.') {
+            return Some(true);
+        }
+        match mode.on_begin {
+            None => Some(false),
+            Some(Callback::Shebang) => Some(found.start != 0),
+            Some(Callback::Jsx) => {
+                let after = &text[found.end..];
+                let next = after.chars().next()?;
+                if next == '<' || next == ',' {
+                    return Some(true);
+                }
+                let mut ignore = false;
+                if next == '>' {
+                    let tag = format!("</{}", &text[found.start + 1..found.end]);
+                    ignore = !after.contains(&tag);
+                }
+                let trimmed = after.trim_start_matches(is_js_space);
+                if trimmed.starts_with('=') {
+                    return Some(true);
+                }
+                if trimmed.len() < after.len() {
+                    if let Some(rest) = trimmed.strip_prefix("extends") {
+                        if rest.starts_with(is_js_space) {
+                            return Some(true);
+                        }
+                    }
+                }
+                Some(ignore)
+            }
+        }
+    }
+
+    fn begin(&mut self, found: &Found) -> Option<usize> {
+        let grammar = self.grammar;
+        let top = *self.stack.last()?;
+        let mode = grammar.modes[top].rules[found.rule].mode?;
+        let definition = &grammar.modes[mode];
+        let lexeme = &self.text[found.start..found.end];
+        if self.ignored(definition, found)? {
+            if grammar.modes[top].regex_index.get() == 0 {
+                let first = lexeme.chars().next()?;
+                self.buffer.push(first);
+                return Some(first.len_utf8());
+            }
+            self.resume = true;
+            return Some(0);
+        }
+        if definition.skip == Some(true) {
+            self.buffer.push_str(lexeme);
+        } else {
+            if definition.exclude_begin {
+                self.buffer.push_str(lexeme);
+            }
+            self.process_buffer()?;
+            if !definition.return_begin && !definition.exclude_begin {
+                self.buffer = lexeme.to_string();
+            }
+        }
+        self.start_mode(mode, found)?;
+        Some(if definition.return_begin { 0 } else { lexeme.len() })
+    }
+
+    fn end(&mut self, found: &Found) -> Option<usize> {
+        let grammar = self.grammar;
+        let lexeme = &self.text[found.start..found.end];
+        let Some(end_depth) = self.end_of_mode(self.stack.len() - 1, &self.text[found.start..])?
+        else {
+            return Some(NO_MATCH);
+        };
+        let origin = &grammar.modes[*self.stack.last()?];
+        let ended = &grammar.modes[self.stack[end_depth]];
+        match &origin.end_scope {
+            Some(scope) if scope.wrap.is_some() => {
+                self.process_buffer()?;
+                self.emit_keyword(lexeme, scope.wrap?);
+            }
+            Some(scope) if scope.multi => {
+                self.process_buffer()?;
+                self.emit_multi(scope, found)?;
+            }
+            _ if origin.skip.is_some() => self.buffer.push_str(lexeme),
+            _ => {
+                if !(origin.return_end || origin.exclude_end) {
+                    self.buffer.push_str(lexeme);
+                }
+                self.process_buffer()?;
+                if origin.exclude_end {
+                    self.buffer = lexeme.to_string();
+                }
+            }
+        }
+        loop {
+            if self.top().has_scope {
+                self.close_node();
+            }
+            self.stack.pop();
+            if self.stack.len() <= end_depth {
+                break;
+            }
+        }
+        if self.stack.is_empty() {
+            return None;
+        }
+        if let Some(starts) = ended.starts {
+            self.start_mode(starts, found)?;
+        }
+        Some(if origin.return_end { 0 } else { lexeme.len() })
+    }
+
+    fn process(&mut self, found: &Found, kind: Kind) -> Option<usize> {
+        let lexeme = &self.text[found.start..found.end];
+        if matches!(self.last, Some((Kind::Begin, index)) if index == found.start)
+            && kind == Kind::End
+            && lexeme.is_empty()
+        {
+            let skipped = self.text[found.start..].chars().next()?;
+            self.buffer.push(skipped);
+            return Some(skipped.len_utf8());
+        }
+        self.last = Some((kind, found.start));
+        match kind {
+            Kind::Begin => return self.begin(found),
+            Kind::End => {
+                let processed = self.end(found)?;
+                if processed != NO_MATCH {
+                    return Some(processed);
+                }
+            }
+            Kind::Illegal => {
+                if lexeme.is_empty() {
+                    return None;
+                }
+            }
+        }
+        self.buffer.push_str(lexeme);
+        Some(lexeme.len())
+    }
+
+    fn run(mut self) -> Option<Vec<u32>> {
+        let grammar = self.grammar;
+        let mut index = 0;
+        let mut iterations = 0;
+        loop {
+            iterations += 1;
+            if iterations > 100_000 {
+                return None;
+            }
+            let top = *self.stack.last()?;
+            if self.resume {
+                self.resume = false;
+            } else {
+                grammar.modes[top].regex_index.set(0);
+            }
+            let Some(found) = grammar.exec(top, self.text, index)? else {
+                break;
+            };
+            let kind = grammar.modes[top].rules[found.rule].kind;
+            self.buffer.push_str(&self.text[index..found.start]);
+            let processed = self.process(&found, kind)?;
+            index = found.start + processed;
+        }
+        self.buffer.push_str(&self.text[index..]);
+        self.process_buffer()?;
+        let total: u32 = self.runs.iter().map(|(_, length)| length).sum();
+        if total as usize != self.text.encode_utf16().count() {
+            return None;
+        }
+        let mut tokens = Vec::new();
+        let mut at = 0;
+        for (scope, length) in self.runs {
+            if let Some(scope) = scope {
+                tokens.extend([at, at + length, scope]);
+            }
+            at += length;
+        }
+        Some(tokens)
+    }
+}
