-            if (isnan(d1) || isnan(d2)) {
-                res = isnan(d1) == isnan(d2);
-            } else if (eq_mode == JS_EQ_SAME_VALUE_ZERO) {
-                res = (d1 == d2); /* +0 == -0 */
-            } else {
-                u1.d = d1;
-                u2.d = d2;
-                res = (u1.u64 == u2.u64); /* +0 != -0 */
-            }
-        } else {
-            res = (d1 == d2); /* if NaN return false and +0 == -0 */
-        }
