+  void _drawBracketHighlight(
+    Canvas canvas,
+    Offset offset,
+    int firstVisibleLine,
+    int lastVisibleLine,
+    bool hasActiveFolds,
+    Color textColor,
+  ) {
+    if (!controller.selection.isValid || !controller.selection.isCollapsed) {
+      return;
+    }
