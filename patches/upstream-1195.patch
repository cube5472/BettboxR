-    void *data[4];
-    data[0] = &this_val;
-    data[1] = &argc;
-    data[2] = argv;
-    data[3] = func_data;
-    JSValue *pret = (JSValue *)opaque->channel(ctx, JSChannelType_METHON, data);
-    if (pret == nullptr) {
-      return JS_ThrowInternalError(ctx, "channel returned null");
