-    if (JS_ToInt32Sat(ctx, &v, argv[0]))
-        return JS_EXCEPTION;
-    ret = (v == 1 || v == 2 || v == 4
-#ifdef CONFIG_BIGNUM
-           || v == 8
-#endif
-           );
-    return JS_NewBool(ctx, ret);
-}
