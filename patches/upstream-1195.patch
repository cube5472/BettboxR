-static JSValue JS_GetIterator2(JSContext *ctx, JSValueConst obj,
-                               JSValueConst method)
-{
-    JSValue enum_obj;
-
-    enum_obj = JS_Call(ctx, method, obj, 0, NULL);
-    if (JS_IsException(enum_obj))
-        return enum_obj;
