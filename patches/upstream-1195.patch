-JSAtom JS_DupAtom(JSContext *ctx, JSAtom v)
-{
-    JSRuntime *rt;
-    JSAtomStruct *p;
-
-    if (!__JS_AtomIsConst(v)) {
-        rt = ctx->rt;
-        p = rt->atom_array[v];
-        p->header.ref_count++;
