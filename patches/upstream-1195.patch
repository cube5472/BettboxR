+ReplaceOperation _replace(int offset) => ReplaceOperation(
+  offset: offset,
+  deletedText: 'a',
+  insertedText: 'b',
+  selectionBefore: TextSelection.collapsed(offset: offset),
+  selectionAfter: TextSelection.collapsed(offset: offset + 1),
+);
