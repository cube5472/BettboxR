-static void set_prop(uint32_t c, int prop_idx, int val)
-{
-    uint32_t mask;
-    mask = 1U << (prop_idx & 0x1f);
-    if (val)
-        unicode_db[c].prop_bitmap_tab[prop_idx >> 5] |= mask;
-    else
-        unicode_db[c].prop_bitmap_tab[prop_idx >> 5]  &= ~mask;
-}
