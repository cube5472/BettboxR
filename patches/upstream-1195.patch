+/// manipulation, especially for large documents.
+///
+/// Example:
+/// ```dart
+/// final controller = CodeForgeController();
+/// controller.text = 'void main() {\n  print("Hello");\n}';
+///
+/// // Access selection
+/// print(controller.selection);
+///
+/// // Get specific line
+/// print(controller.getLineText(0)); // 'void main() {'
