+  final scopes = yaml ? _scopes : _javascriptScopes;
+  final units = List<String?>.filled(line.length, null);
+  for (var i = 0; i < tokens.length; i += 3) {
+    units.fillRange(tokens[i], tokens[i + 1], scopes[tokens[i + 2]]);
