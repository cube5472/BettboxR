-    case TOK_CONST:
-    haslet:
-        if (!(decl_mask & DECL_MASK_OTHER)) {
-            js_parse_error(s, "lexical declarations can't appear in single-statement context");
-            goto fail;
-        }
-        /* fall thru */
-    case TOK_VAR:
-        if (next_token(s))
-            goto fail;
-        if (js_parse_var(s, TRUE, tok, FALSE))
-            goto fail;
-        if (js_parse_expect_semi(s))
-            goto fail;
-        break;
