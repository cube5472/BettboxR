-  /// Evaluate js script.
-  dynamic evaluate(
-    String command, {
-    String? name,
-    int? evalFlags,
-  }) {
-    _ensureEngine();
-    final ctx = _ctx!;
-    final jsval = jsEval(
-      ctx,
-      command,
-      name ?? '<eval>',
-      evalFlags ?? JSEvalFlag.GLOBAL,
-    );
-    try {
-      if (jsIsException(jsval) != 0) {
-        throw _parseJSException(ctx);
-      }
-      return _jsToDart(ctx, jsval);
-    } finally {
-      jsFreeValue(ctx, jsval);
-    }
-  }
-}
