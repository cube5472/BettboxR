-static int bc_put_atom(BCWriterState *s, JSAtom atom)
-{
-    uint32_t v;
-
-    if (__JS_AtomIsTaggedInt(atom)) {
-        v = (__JS_AtomToUInt32(atom) << 1) | 1;
-    } else {
-        if (bc_atom_to_idx(s, &v, atom))
-            return -1;
-        v <<= 1;
-    }
-    bc_put_leb128(s, v);
-    return 0;
-}
