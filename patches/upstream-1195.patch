-    /* consume the '}' */
-    if (next_token(s))
-        goto fail;
-
-    /* store the function to initialize the fields to that it can be
-       referenced by the constructor */
-    {
-        ClassFieldsDef *cf = &class_fields[0];
-        int var_idx;
-        
-        var_idx = define_var(s, fd, JS_ATOM_class_fields_init,
-                             JS_VAR_DEF_CONST);
-        if (var_idx < 0)
