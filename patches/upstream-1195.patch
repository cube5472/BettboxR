-    }
-
-    JS_FreeAtom(ctx, class_name);
-    JS_FreeAtom(ctx, class_var_name);
-    fd->js_mode = saved_js_mode;
-    return 0;
- fail:
-    JS_FreeAtom(ctx, name);
-    JS_FreeAtom(ctx, class_name);
-    JS_FreeAtom(ctx, class_var_name);
-    fd->js_mode = saved_js_mode;
