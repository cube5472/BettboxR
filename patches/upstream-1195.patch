-                var_ref = get_var_ref(ctx, sf, cv->var_idx, cv->is_arg);
-                if (!var_ref)
-                    goto fail;
-            } else {
-                var_ref = cur_var_refs[cv->var_idx];
-                var_ref->header.ref_count++;
-            }
-            var_refs[i] = var_ref;
-        }
-    }
-    return func_obj;
- fail:
-    /* bfunc is freed when func_obj is freed */
-    JS_FreeValue(ctx, func_obj);
-    return JS_EXCEPTION;
-}
