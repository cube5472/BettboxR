-              final y = screenY + lineHeight - decoration.thickness;
-              path.moveTo(x, y);
-              while (x < screenX + width) {
-                path.quadraticBezierTo(
-                  x + waveWidth / 4,
-                  y - waveHeight,
-                  x + waveWidth / 2,
-                  y,
-                );
-                path.quadraticBezierTo(
-                  x + waveWidth * 3 / 4,
-                  y + waveHeight,
-                  x + waveWidth,
-                  y,
-                );
